+class CicadaLongWorkload : public YcsbWorkload {
+public:
+  template <typename Tx, typename TransactionStatus>
+  void run(Tx& tx) {
+    auto& slot = long_slots[tx.thid_];
+    bool is_long = tx.thid_ != 0 && FLAGS_cicada_long_threads != 0 &&
+                   tx.thid_ >= TotalThreadNum - FLAGS_cicada_long_threads;
+    slot.is_long = is_long;
+    uint64_t old_commits = tx.result_->local_commit_counts_;
+    uint64_t old_aborts = tx.result_->local_abort_counts_;
+    if (!is_long) {
+      YcsbWorkload::run<Tx, TransactionStatus>(tx);
+      slot.commits += tx.result_->local_commit_counts_ - old_commits;
+      slot.aborts += tx.result_->local_abort_counts_ - old_aborts;
+      return;
+    }
+
+    tx.pro_set_.clear();
+    if (FLAGS_cicada_long_kind == "many_ops") {
+      for (uint64_t i = 0; i < FLAGS_cicada_long_ops; ++i) {
+        uint64_t key = zipf_() % FLAGS_ycsb_tuple_num;
+        bool read = i + 1 != FLAGS_cicada_long_ops &&
+                    (i == 0 || rnd_.next() % 100 < FLAGS_cicada_long_rratio);
+        tx.pro_set_.emplace_back(read ? Ope::READ : Ope::WRITE, key);
+      }
+    } else {
+      for (uint64_t i = 0; i < FLAGS_cicada_wait_reads; ++i)
+        tx.pro_set_.emplace_back(Ope::READ, zipf_() % FLAGS_ycsb_tuple_num);
+      tx.pro_set_.emplace_back(Ope::WRITE, zipf_() % FLAGS_ycsb_tuple_num);
+    }
+    tx.pro_set_.front().ronly_ = false;
+    tx.pro_set_.front().wonly_ = false;
+    tx.is_ronly_ = false;
+
+  RETRY:
+    if (tx.isLeader()) tx.leaderWork();
+    if (loadAcquire(tx.quit_)) {
+      slot.commits += tx.result_->local_commit_counts_ - old_commits;
+      slot.aborts += tx.result_->local_abort_counts_ - old_aborts;
+      return;
+    }
+    tx.begin();
+    for (auto& pro : tx.pro_set_) {
+      SimpleKey<8> key;
+      YCSB::CreateKey(pro.key_, key.ptr());
+      if (pro.ope_ == Ope::READ) {
+        TupleBody* body = nullptr;
+        tx.read(Storage::YCSB, key.view(), &body);
+        if (tx.status_ != TransactionStatus::aborted && body) {
+          [[maybe_unused]] YCSB& value = body->get_value().cast_to<YCSB>();
+        }
+      } else {
+        HeapObject obj;
+        obj.template allocate<YCSB>();
+        [[maybe_unused]] YCSB& value = obj.ref();
+        tx.update(Storage::YCSB, key.view(),
+                  TupleBody(key.view(), std::move(obj)));
+      }
+      if (tx.status_ == TransactionStatus::aborted) {
+        tx.abort();
+        ++tx.result_->local_abort_counts_;
+        goto RETRY;
+      }
+    }
+    if (FLAGS_cicada_long_kind == "wait_after_reads")
+      std::this_thread::sleep_for(
+          std::chrono::microseconds(FLAGS_cicada_long_wait_us));
+    if (!tx.commit()) {
+      tx.abort();
+      ++tx.result_->local_abort_counts_;
+      goto RETRY;
+    }
+    storeRelease(tx.result_->local_commit_counts_,
+                 loadAcquire(tx.result_->local_commit_counts_) + 1);
+    slot.commits += tx.result_->local_commit_counts_ - old_commits;
+    slot.aborts += tx.result_->local_abort_counts_ - old_aborts;
+  }
+};
