+// reached: read-set elements examined; changed: elements with rts below tx wts left unchanged;
+ // committed: changed events in transactions that committed.
+ namespace {
+ struct BreakEvent { uint64_t tx, a, b; std::string key; };
+ std::atomic<uint64_t> break_reached{0}, break_changed{0}, break_committed{0};
+ thread_local std::vector<BreakEvent> break_pending;
+ std::string break_hex(const std::string& key) {
+   static constexpr char digits[] = "0123456789abcdef";
+   std::string out;
+   for (unsigned char c : key) { out += digits[c >> 4]; out += digits[c & 15]; }
+   return out;
+ }
+ void break_commit() {
+   for (const auto& e : break_pending) {
+     break_committed.fetch_add(1, std::memory_order_relaxed);
+     std::fprintf(stderr, "CICADA_BREAK_EVENT slug=no-rts-update tx_wts=%llu key=%s a_wts=%llu b_wts=%llu\n",
+                    static_cast<unsigned long long>(e.tx),
+                    break_hex(e.key).c_str(),
+                    static_cast<unsigned long long>(e.a),
+                    static_cast<unsigned long long>(e.b));
+   }
+   break_pending.clear();
+ }
+ struct BreakReport {
+   ~BreakReport() {
+     std::fprintf(stderr, "CICADA_BREAK_FIRED slug=no-rts-update reached=%llu changed=%llu committed=%llu\n",
+                  static_cast<unsigned long long>(break_reached.load()),
+                  static_cast<unsigned long long>(break_changed.load()),
+                  static_cast<unsigned long long>(break_committed.load()));
+   }
+ } break_report;
+ }  // namespace
 
