diff --git a/cmake/Options.cmake b/cmake/Options.cmake
index 0000000..0000000 100644
--- a/cmake/Options.cmake
+++ b/cmake/Options.cmake
@@ -21,6 +21,16 @@
 set(CCBENCH_KEY_SIZE      8 CACHE STRING "key size in bytes (YCSB)")
 set(CCBENCH_MASSTREE_USE  1 CACHE STRING "use Masstree as the index")
 set(CCBENCH_VAL_SIZE      4 CACHE STRING "value size in bytes (YCSB)")
+
+# izanagi (Phase 3 段5, D41): write_set 施錠順序 comparator (silo only) を coder
+# が変異させる軸。0 (既定) = stock (WriteElement::operator< をそのまま使う
+# 逐語温存)。1 = coder 合成枝 (EVOLVE-BLOCK #if 枝) を選択。値でなくコード片
+# (comparator) の変異のため BACKOFF_FIXED のような数値 sentinel でなく単純な
+# on/off スイッチ (D41 決定5)。silo 専用マクロだが、プロトコル固有 OPTIONS で
+# 配線すると protocol CMakeLists が ALLOWLIST 外の改変になる (D23) ため
+# universal に相乗りし、未使用の他プロトコルバイナリには単に無害なマクロが
+# 渡るだけにする (このファイル = cmake/Options.cmake のみの改変で完結)。
+set(CCBENCH_SORT_VARIANT  0 CACHE STRING "izanagi: 0=stock write_set sort; 1=coder-synthesized comparator (EVOLVE-BLOCK, silo only)")
 
 # ----- multi-protocol (used by 2+ protocols) -----
 set(CCBENCH_KEY_SORT                       0 CACHE STRING "")
@@ -65,6 +75,7 @@
     MASSTREE_USE=${CCBENCH_MASSTREE_USE}
     VAL_SIZE=${CCBENCH_VAL_SIZE}
     TRACE=${CCBENCH_TRACE}
+    SORT_VARIANT=${CCBENCH_SORT_VARIANT}
     PARENT_SCOPE)
 endfunction()
 
diff --git a/cc/silo/transaction.cc b/cc/silo/transaction.cc
index c8e35d0..c9ddf1b 100644
--- a/cc/silo/transaction.cc
+++ b/cc/silo/transaction.cc
@@ -405,7 +405,32 @@ bool TxExecutor::validationPhase() { // Validation Phase
   for (auto& we : write_set_) izanagi_pre_sort_rcdptrs.insert(we.rcdptr_);
 #endif
 
+#ifndef SORT_VARIANT
+#error "SORT_VARIANT must be defined (-DSORT_VARIANT=0 for stock; CMake supplies the default)"
+#endif
+  // EVOLVE-BLOCK-BEGIN silo-writeset-sort
+  // izanagi Phase 3 (D41/phase3.md): this conditional-compilation skeleton
+  // (if/else/endif) is the coder (LLM) edit surface. The coder writes only
+  // the synthesized branch (selected when SORT_VARIANT >= 1) -- a comparator
+  // for the write_set_ lock-acquisition order, in place of stock's default
+  // WriteElement::operator< (silo_op_element.hh). Default 0 selects the
+  // stock branch and preprocesses byte-identical to the original (inert,
+  // 規律2, D18/D23 sentinel convention). Closed-region constraint (D23 道Y,
+  // hook-enforced where possible): straight-line code calling existing silo
+  // APIs only inside the comparator body. No #include changes, no new
+  // functions/types/structs/globals/macros outside this lambda, no raw
+  // preprocessor directives, no nondeterministic builtins (this comment
+  // avoids raw tokens so marker scanning does not false-positive).
+#if SORT_VARIANT
+  sort(write_set_.begin(), write_set_.end(),
+       [](const WriteElement<Tuple>& a, const WriteElement<Tuple>& b) -> bool {
+         return a.storage_ != b.storage_ ? a.storage_ < b.storage_
+                                         : a.key_ < b.key_;  // coder 編集面
+       });
+#else
   sort(write_set_.begin(), write_set_.end());
+#endif
+  // EVOLVE-BLOCK-END silo-writeset-sort
 
 #if TRACE
   // Permutation-preservation check, post-sort verdict (D41 決定2). Outside
