+// Find the first non-aborted version immediately above each held version.
+template <typename Reads>
+bool forward_upper(const Reads& reads, uint64_t& upper) {
+  upper = std::numeric_limits<uint64_t>::max();
+  for (const auto& r : reads) {
+    Version* cursor = r.rcdptr_->ldAcqLatest();
+    uint64_t adjacent = std::numeric_limits<uint64_t>::max();
+    const uint64_t held_wts = r.ver_->ldAcqWts();
+    while (cursor && cursor != r.ver_ && cursor->ldAcqWts() > held_wts) {
+      if (cursor->ldAcqStatus() != VersionStatus::aborted)
+        adjacent = cursor->ldAcqWts();
+      cursor = cursor->ldAcqNext();
+    }
+    if (cursor != r.ver_) return false;
+    upper = std::min(upper, adjacent);
+  }
+  return true;
+}
+
+bool forward_below(uint64_t upper, uint8_t thid, uint64_t& result) {
+  if (upper == 0) return false;
+  result = ((upper - 1) & ~uint64_t{255}) | thid;
+  if (result >= upper) {
+    if (result < 256) return false;
+    result -= 256;
+  }
+  return result < upper;
+}
