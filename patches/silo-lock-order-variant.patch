+// SILO-LOCK-ORDER-SORT-BEGIN
+template <typename Elements, typename Enabled, typename Priority, typename ReadWord>
+void sort_write_set(Elements& ws, Enabled enabled, Priority priority, ReadWord read_word) {
+  for (const auto& e : ws) {
+    if (e.op_ == OpType::INSERT || e.op_ == OpType::DELETE) {
+      sort(ws.begin(), ws.end());
+      return;
+    }
+  }
+  if (!enabled(static_cast<uint32_t>(ws.size()))) {
+    sort(ws.begin(), ws.end());
+    return;
+  }
+  std::vector<uint64_t> priorities;
+  std::vector<std::size_t> order;
+  priorities.reserve(ws.size());
+  order.reserve(ws.size());
+  for (std::size_t i = 0; i < ws.size(); ++i) {
+    const auto entry = read_word(ws[i]);
+    priorities.push_back(priority(entry));
+    order.push_back(i);
+  }
+  sort(order.begin(), order.end(), [&](std::size_t a, std::size_t b) {
+    if (priorities[a] != priorities[b]) return priorities[a] > priorities[b];
+    if (ws[a].storage_ != ws[b].storage_) return ws[a].storage_ < ws[b].storage_;
+    return ws[a].key_ < ws[b].key_;
+  });
+  Elements sorted;
+  sorted.reserve(ws.size());
+  for (auto i : order) sorted.push_back(std::move(ws[i]));
+  ws = std::move(sorted);
+}
+// SILO-LOCK-ORDER-SORT-END
