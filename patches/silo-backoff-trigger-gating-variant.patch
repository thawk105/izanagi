+#if BACKOFF_TRIGGER_GATING
+// izanagi (Phase 3 stage 8a, D48): abort-reason recording -- the
+// human-installed skeleton of the silo-backoff-trigger-gating axis.
+// Recording is the skeleton's exclusive domain (the coder must not touch
+// it): if the coder could write these stores it could forge reasons to
+// dress up the gate (reward-hack path, D48 decision 3; DiffQuarantine
+// rejects edits outside the EVOLVE-BLOCK hole line-by-line). thread_local
+// at file scope keeps the whole mechanism inside cc/silo/transaction.cc
+// (EVOLVE_BLOCK_SOURCES) -- one TxExecutor per worker thread (ycsb.hh
+// worker 1:1), so per-thread semantics match per-executor semantics. This
+// is CC-native metadata read by the gate in the perf build -- deliberately
+// NOT under #if TRACE (it would break the gate in the perf build; 規律1
+// "CC 本来のもの" side). The whole block vanishes when
+// BACKOFF_TRIGGER_GATING=0, so the stock genome preprocesses
+// byte-identical to pinned HEAD (inert, D48/F1 -- src_token="stock").
+enum class IzanagiAbortReason : unsigned char {
+  kUnset = 0,      // sentinel: not recorded (e.g. app-layer aborts in
+                   // non-YCSB workloads) -> gate must take stock behavior
+                   // (do back off). Fail-safe contract (D48/AUD-2).
+  kLockConflict,   // lockWriteSet: NO_WAIT lock conflict
+  kUpdateAbsent,   // lockWriteSet: UPDATE target absent
+  kReadValiTid,    // validationPhase: read-set tid/epoch changed
+  kReadValiLocked, // validationPhase: locked and not own write
+  kNodeVali,       // validationPhase: node version changed
+  kInsertNode,     // insert: node version mismatch (YCSB never fires)
+  kScanNode,       // scan callback: node version mismatch (YCSB never fires)
+};
+static thread_local IzanagiAbortReason izanagi_abort_reason_ =
+    IzanagiAbortReason::kUnset;
+#endif
