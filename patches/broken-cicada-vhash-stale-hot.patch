+namespace {
+struct VHashBreakEvent { uint64_t tx, read_wts; std::string key; };
+std::atomic<uint64_t> vh_break_reached{0}, vh_break_changed{0}, vh_break_committed{0};
+thread_local std::vector<VHashBreakEvent> vh_break_pending;
+std::string vh_break_hex(std::string_view key) {
+  static constexpr char digits[] = "0123456789abcdef";
+  std::string out;
+  for (unsigned char c : key) { out += digits[c >> 4]; out += digits[c & 15]; }
+  return out;
+}
+void vh_break_log(const char* stage, uint64_t tx, std::string_view key,
+                  uint64_t read_wts) {
+  fprintf(stderr, "CICADA_BREAK_EVENT slug=stale-hot stage=%s tx_wts=%llu key=%s read_wts=%llu\n",
+          stage, (unsigned long long)tx, vh_break_hex(key).c_str(),
+          (unsigned long long)read_wts);
+}
+void vh_break_commit() {
+  for (const auto& e : vh_break_pending) {
+    ++vh_break_committed;
+    vh_break_log("committed", e.tx, e.key, e.read_wts);
+  }
+  vh_break_pending.clear();
+}
+struct VHashBreakReport {
+  ~VHashBreakReport() {
+    fprintf(stderr, "CICADA_BREAK_FIRED slug=stale-hot reached=%llu changed=%llu committed=%llu\n",
+            (unsigned long long)vh_break_reached.load(),
+            (unsigned long long)vh_break_changed.load(),
+            (unsigned long long)vh_break_committed.load());
+  }
+} vh_break_report;
+}
