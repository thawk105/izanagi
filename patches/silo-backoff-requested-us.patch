+#if BACKOFF_REQUESTED_US
+// IZANAGI_BACKOFF_REQUESTED_US_COUNTER_BEGIN
+namespace {
+class IzanagiBackoffRequestedUsCounter {
+public:
+  static constexpr std::uint64_t states_[11] = {
+      0, 100, 200, 300, 400, 500, 600, 700, 800, 900, 1000};
+
+  std::uint64_t call_count_ = 0;
+  std::uint64_t requested_us_sum_ = 0;
+  std::uint64_t bucket_counts_[11] = {0};
+  std::uint64_t unknown_state_call_count_ = 0;
+  bool counter_overflowed_ = false;
+
+  void record(double requested_us) {
+    add(call_count_, 1);
+    if (!std::isfinite(requested_us)) {
+      add(unknown_state_call_count_, 1);
+      return;
+    }
+    for (std::size_t index = 0; index < 11; ++index) {
+      if (requested_us == static_cast<double>(states_[index])) {
+        add(bucket_counts_[index], 1);
+        add(requested_us_sum_, states_[index]);
+        return;
+      }
+    }
+    add(unknown_state_call_count_, 1);
+  }
+
+  void merge(const IzanagiBackoffRequestedUsCounter& other) {
+    add(call_count_, other.call_count_);
+    add(requested_us_sum_, other.requested_us_sum_);
+    for (std::size_t index = 0; index < 11; ++index)
+      add(bucket_counts_[index], other.bucket_counts_[index]);
+    add(unknown_state_call_count_, other.unknown_state_call_count_);
+    counter_overflowed_ = counter_overflowed_ || other.counter_overflowed_;
+  }
+
+private:
+  void add(std::uint64_t& target, std::uint64_t amount) {
+    const std::uint64_t maximum = ~std::uint64_t{0};
+    if (amount > maximum - target) {
+      target = maximum;
+      counter_overflowed_ = true;
+      return;
+    }
+    target += amount;
+  }
+};
+
+class IzanagiBackoffRequestedUsRegistry {
+public:
+  IzanagiBackoffRequestedUsCounter* register_worker() {
+    auto* counter = new IzanagiBackoffRequestedUsCounter();
+    while (registration_lock_.test_and_set(std::memory_order_acquire))
+      _mm_pause();
+    workers_.push_back(counter);
+    registration_lock_.clear(std::memory_order_release);
+    return counter;
+  }
+
+  ~IzanagiBackoffRequestedUsRegistry() {
+    IzanagiBackoffRequestedUsCounter total;
+    for (const auto* worker : workers_) total.merge(*worker);
+    fprintf(
+        stdout,
+        "IZANAGI_BACKOFF_REQUESTED_US_V1 call_count=%llu "
+        "requested_us_sum=%llu state_0_call_count=%llu "
+        "state_100_call_count=%llu state_200_call_count=%llu "
+        "state_300_call_count=%llu state_400_call_count=%llu "
+        "state_500_call_count=%llu state_600_call_count=%llu "
+        "state_700_call_count=%llu state_800_call_count=%llu "
+        "state_900_call_count=%llu state_1000_call_count=%llu "
+        "unknown_state_call_count=%llu counter_overflowed=%u\n",
+        static_cast<unsigned long long>(total.call_count_),
+        static_cast<unsigned long long>(total.requested_us_sum_),
+        static_cast<unsigned long long>(total.bucket_counts_[0]),
+        static_cast<unsigned long long>(total.bucket_counts_[1]),
+        static_cast<unsigned long long>(total.bucket_counts_[2]),
+        static_cast<unsigned long long>(total.bucket_counts_[3]),
+        static_cast<unsigned long long>(total.bucket_counts_[4]),
+        static_cast<unsigned long long>(total.bucket_counts_[5]),
+        static_cast<unsigned long long>(total.bucket_counts_[6]),
+        static_cast<unsigned long long>(total.bucket_counts_[7]),
+        static_cast<unsigned long long>(total.bucket_counts_[8]),
+        static_cast<unsigned long long>(total.bucket_counts_[9]),
+        static_cast<unsigned long long>(total.bucket_counts_[10]),
+        static_cast<unsigned long long>(total.unknown_state_call_count_),
+        total.counter_overflowed_ ? 1U : 0U);
+    fflush(stdout);
+  }
+
+private:
+  std::atomic_flag registration_lock_ = ATOMIC_FLAG_INIT;
+  std::vector<IzanagiBackoffRequestedUsCounter*> workers_;
+};
+
+IzanagiBackoffRequestedUsRegistry izanagi_backoff_requested_us_registry;
+
+IzanagiBackoffRequestedUsCounter&
+izanagi_backoff_requested_us_worker_counter() {
+  thread_local IzanagiBackoffRequestedUsCounter* const counter =
+      izanagi_backoff_requested_us_registry.register_worker();
+  return *counter;
+}
