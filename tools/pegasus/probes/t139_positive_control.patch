+
+inline std::uint64_t load_window(const std::string& key, std::size_t begin) {
+  std::uint64_t word = 0;
+  if (begin >= key.size()) return word;
+  const std::size_t available = key.size() - begin;
+  const std::size_t count =
+      available < sizeof(word) ? available : sizeof(word);
+  std::memcpy(&word, key.data() + begin, count);
+  return word;
+}
+
+inline std::uint64_t finalize(std::uint64_t value) {
+  value ^= value >> 30;
+  value *= 0xbf58476d1ce4e5b9ULL;
+  value ^= value >> 27;
+  value *= 0x94d049bb133111ebULL;
+  value ^= value >> 31;
+  return value;
+}
+
+inline std::size_t stripe_for(Storage storage, const std::string& key) {
+  const std::size_t middle = key.size() / 2;
+  const std::size_t tail = key.size() > 8 ? key.size() - 8 : 0;
+  std::uint64_t mixed = load_window(key, 0);
+  mixed ^= load_window(key, middle) * 0x9e3779b97f4a7c15ULL;
+  mixed ^= load_window(key, tail) * 0xbf58476d1ce4e5b9ULL;
+  mixed ^= static_cast<std::uint64_t>(key.size()) * 0x94d049bb133111ebULL;
+  mixed ^= static_cast<std::uint64_t>(storage) * 0xd6e8feb86659fd93ULL;
+  return static_cast<std::size_t>(finalize(mixed) % 4);
+}
+#endif
+}  // namespace izanagi_t139_positive_control
