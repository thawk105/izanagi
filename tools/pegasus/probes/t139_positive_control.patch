+};
+std::atomic<const LivenessClock::time_point*> liveness_start{nullptr};
+
+inline LivenessWindowState& liveness_window_state() {
+  static thread_local LivenessWindowState state;
+  return state;
+}
+
+inline void set_liveness_start(const LivenessClock::time_point& start) {
+  liveness_start.store(&start, std::memory_order_release);
+}
+
+inline void report_commit_window(std::size_t worker) {
+  LivenessWindowState& state = liveness_window_state();
+  const LivenessClock::time_point* const start =
+      liveness_start.load(std::memory_order_acquire);
+  if (start == nullptr) return;
+  static constexpr std::chrono::milliseconds split{1500};
+  static constexpr std::chrono::milliseconds finish{3000};
+  const auto elapsed = LivenessClock::now() - *start;
+  std::size_t window;
+  if (elapsed < split) {
+    window = 0;
+  } else if (elapsed < finish) {
+    window = 1;
+  } else {
+    return;
+  }
+  if (!state.reported[window]) {
+    state.reported[window] = true;
+    std::fprintf(stdout, "izanagi_t139_pc.window[%zu].worker[%zu]=1\n",
+                 window + 1, worker);
+  }
+}
+}  // namespace izanagi_t139_positive_control
+#endif
