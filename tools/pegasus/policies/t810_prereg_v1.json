    "caveats": [
      "truncated_zero_is_not_equal_nodes",
      "single_arm_does_not_identify_additive_vs_multiplicative",
      "one-treatment-one-node_comparison_remains_forbidden",
      "zero_variance_p_value_is_secondary_only"
    ],
    "order": [
      1,
      2,
      3,
      4,
      5
    ],
    "rules": [
      {
        "order": 1,
        "outcome_code": "terminal-state-code",
        "predicate": "terminal_state not in {valid,terminal_reduced}"
      },
      {
        "order": 2,
        "outcome_code": "underdetermined_model_violation",
        "predicate": "slope_gate_fired"
      },
      {
        "order": 3,
        "outcome_code": "material_node_difference_refuted",
        "predicate": "tau_U < tau_star"
      },
      {
        "order": 4,
        "outcome_code": "material_node_difference_supported",
        "predicate": "tau_L > tau_star"
      },
      {
        "order": 5,
        "outcome_code": "underdetermined",
        "predicate": "otherwise-including-equality"
      }
    ],
    "slope_gate": {
      "S_beta": "sum((beta_i-beta_bar)^2)/(N-1)",
      "V_beta": "sum(se_i^2)/N",
      "fit": "per-node-ordinary-least-squares",
      "multiplier": "2",
      "operator": ">",
      "per_node_df": "R-2",
      "per_node_df_selected": 8,
      "predicate": "S_beta > 2*V_beta",
      "predictor": "round-index-1-through-R",
      "response": "natural-log-throughput"
    },
    "strategy": "first-match"
  },
