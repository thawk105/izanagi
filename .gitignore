# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# C++ ビルド成果物
*.o
*.a
*.so
build/
*.out

# Izanagi の成果物 (生ログ等。reports/insights は残す判断もありうるので適宜調整)
output/runs/
output/variants/*/bin/
output/env/*/binaries/
# S-1 driver のビルドキャッシュ (数万ファイル・GB 級の生成物。WAL/report が正本で、キャッシュは再生成可能)
output/s1-build-cache/
# dev-wave supervisor の private runtime (control WAL・raw child 出力。tracked 化すると supervisor 自身が main の clean gate を壊す)
output/dev-wave-supervisor/runtime/
output/env/pegasus/silo_ladder_rung1/job-staging/
output/env/pegasus/floor/job-staging/
output/pegasus-dispatch/
# campaign 単位 advisory flock の実行時 lock file ([T-565])。内容は空、識別子は layout.root の hash
output/campaign-locks/

# CCBench submodule のビルド成果物 (submodule 自体は追跡)
external/ccbench/build/

# OS / エディタ
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/settings.json
