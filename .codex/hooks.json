{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "R=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$R\" ] && [ -f \"$R/hooks/codex_guard.sh\" ] || exit 2; bash \"$R/hooks/codex_guard.sh\" write"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "R=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$R\" ] && [ -f \"$R/hooks/codex_guard.sh\" ] || exit 2; bash \"$R/hooks/codex_guard.sh\" bash"
          }
        ]
      }
    ]
  }
}
