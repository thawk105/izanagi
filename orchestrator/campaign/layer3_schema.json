{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Izanagi Layer 3 material report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta", "workload", "variants", "runs", "verifications", "rejects", "aborts", "noise_floor", "env_tags", "whiteboard", "whiteboard_provenance", "artifact_refs", "source_refs", "admission_decision", "mechanism_hypotheses"],
  "properties": {
    "schema_version": {"const": "layer3-material-report/v3"},
    "meta": {"type": "object", "additionalProperties": false, "required": ["campaign_id", "campaign_path", "ccbench_commit", "generated_from_head", "generator"], "properties": {"campaign_id": {"type": "string", "minLength": 1}, "campaign_path": {"type": "string", "minLength": 1}, "ccbench_commit": {"type": "string"}, "generated_from_head": {"type": "string", "minLength": 1, "description": "provenance only; excluded from deterministic comparison because HEAD can move"}, "generator": {"type": "object", "additionalProperties": false, "required": ["identity", "sha256"], "properties": {"identity": {"const": "orchestrator.campaign.layer3_report"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}},
    "workload": {"type": "object"},
    "policy_hint": {"type": ["string", "null"]},
    "variants": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["variant", "genome", "src_token", "events"], "properties": {"variant": {"type": "string"}, "genome": {"type": "array", "items": {"type": "string"}}, "src_token": {"type": "array", "items": {"type": "string"}}, "events": {"type": "array", "items": {"type": "object"}}}}},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant", "source_ref", "tps", "median_tps", "cv", "rounds", "leading_indicators"],
        "not": {"required": ["screening", "screening_disabled"]},
        "properties": {
          "variant": {"type": "string"},
          "source_ref": {"$ref": "#/definitions/wal_ref"},
          "tps": {"type": "array"},
          "median_tps": {"type": "number"},
          "cv": {"type": "number"},
          "bench_wall_s": {"type": "number", "minimum": 0},
          "rounds": {"type": "integer"},
          "leading_indicators": {"type": "object"},
          "high_variance": {"type": "boolean"},
          "unstable": {"type": "boolean"},
          "cv_history": {"type": "array"},
          "settled": {"type": ["boolean", "null"]},
          "rep_notes": {"type": "array"},
          "run_cmd": {"type": "string"},
          "rep_returncodes": {"type": "array", "items": {"type": "integer"}},
          "screening": {"const": true},
          "screening_disabled": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason", "age_s", "threshold_s", "baseline_ref"],
            "properties": {
              "reason": {"const": "stale-baseline"},
              "age_s": {"type": "number", "exclusiveMinimum": 0},
              "threshold_s": {"type": "number", "exclusiveMinimum": 0},
              "baseline_ref": {"type": "string", "minLength": 1}
            }
          },
          "perf_observation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["use_perf", "counter_status", "missing_leading_indicators", "preflight"],
            "allOf": [
              {
                "if": {"properties": {"use_perf": {"const": false}}},
                "then": {
                  "required": ["claim_scope"],
                  "properties": {
                    "counter_status": {"const": "not_required"},
                    "missing_leading_indicators": {"maxItems": 0},
                    "preflight": {"properties": {"available": {"const": false}}}
                  }
                }
              },
              {
                "if": {"properties": {"use_perf": {"const": true}}},
                "then": {
                  "not": {"required": ["claim_scope"]},
                  "properties": {
                    "counter_status": {"enum": ["complete", "incomplete"]},
                    "preflight": {"properties": {"available": {"const": true}}}
                  }
                }
              },
              {
                "if": {"properties": {"counter_status": {"const": "complete"}}},
                "then": {
                  "properties": {
                    "use_perf": {"const": true},
                    "missing_leading_indicators": {"maxItems": 0}
                  }
                }
              },
              {
                "if": {"properties": {"counter_status": {"const": "incomplete"}}},
                "then": {
                  "properties": {
                    "use_perf": {"const": true},
                    "missing_leading_indicators": {"minItems": 1}
                  }
                }
              }
            ],
            "properties": {
              "use_perf": {"type": "boolean"},
              "counter_status": {"enum": ["not_required", "complete", "incomplete"]},
              "missing_leading_indicators": {
                "type": "array",
                "items": {"enum": ["llc_miss_rate", "ipc"]},
                "uniqueItems": true
              },
              "claim_scope": {
                "type": "object",
                "additionalProperties": false,
                "required": ["throughput", "perf_required"],
                "properties": {
                  "throughput": {"const": "eligible"},
                  "perf_required": {"const": "unsupported"}
                }
              },
              "preflight": {
                "type": "object",
                "additionalProperties": false,
                "required": ["schema", "status", "available", "probe_argv", "rc", "parsed_events", "reason", "stderr_sha256", "candidates"],
                "allOf": [
                  {
                    "if": {"properties": {"status": {"const": "available"}}},
                    "then": {
                      "properties": {
                        "available": {"const": true},
                        "reason": {"const": "available"}
                      }
                    }
                  },
                  {
                    "if": {"properties": {"status": {"const": "unavailable"}}},
                    "then": {
                      "properties": {
                        "available": {"const": false},
                        "reason": {
                          "enum": ["nonzero-rc", "requested-events-missing", "perf-not-found"]
                        }
                      }
                    }
                  },
                  {
                    "if": {"properties": {"status": {"const": "probe_error"}}},
                    "then": false
                  }
                ],
                "properties": {
                  "schema": {"const": "izanagi-perf-preflight/v1"},
                  "status": {"enum": ["available", "unavailable", "probe_error"]},
                  "available": {"type": "boolean"},
                  "probe_argv": {"type": "array", "items": {"type": "string"}},
                  "rc": {"type": ["integer", "null"]},
                  "parsed_events": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                  "reason": {"enum": ["available", "nonzero-rc", "perf-not-found", "requested-events-missing", "probe-timeout", "probe-os-error", "probe-signal"]},
                  "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "candidates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["path", "rc", "executable"],
                      "properties": {
                        "path": {"type": "string", "minLength": 1},
                        "rc": {"type": ["integer", "null"]},
                        "executable": {"type": "boolean"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "verifications": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["variant", "source_ref", "verdict", "certified"], "properties": {"variant": {"type": "string"}, "source_ref": {"$ref": "#/definitions/wal_ref"}, "verdict": {"type": "string"}, "certified": {"type": "boolean"}, "commits": {"type": "integer"}, "aborts": {"type": "integer"}, "anomalies": {"type": "integer"}, "workload": {"type": "object"}}}},
    "rejects": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["variant", "reason", "source_ref"], "properties": {"variant": {"type": "string"}, "reason": {"enum": ["commit-event-absent"]}, "source_ref": {"$ref": "#/definitions/wal_ref"}}}},
    "aborts": {"type": "array", "items": {"type": "object", "required": ["variant", "source_ref", "reason"], "properties": {"variant": {"type": "string"}, "source_ref": {"$ref": "#/definitions/wal_ref"}, "reason": {"type": "string", "minLength": 1}}}},
    "noise_floor": {"type": "object", "additionalProperties": false, "required": ["within_run", "between_run"], "properties": {"within_run": {"$ref": "#/definitions/floor_result"}, "between_run": {"$ref": "#/definitions/floor_result"}}},
    "env_tags": {"type": "array", "items": {"type": "string"}},
    "whiteboard": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["iteration", "direction", "magnitude", "result", "delta_pct"], "properties": {"iteration": {"type": "integer"}, "direction": {"type": "string"}, "magnitude": {"type": "string"}, "result": {"type": "string"}, "delta_pct": {"type": ["number", "null"]}}}},
    "whiteboard_provenance": {"enum": ["loop_state", "absent"]},
    "artifact_refs": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "source_refs": {"type": "array", "items": {"type": "string", "pattern": "^(wal|wb):[0-9a-f]{64}$"}},
    "admission_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "classification", "admission_status", "verification_status", "campaign_id", "campaign_path", "campaign_lock_sha256", "wal_sha256", "policy_sha256", "attempt_receipt_sha256s", "validator", "overlay"],
      "properties": {
        "schema_version": {"const": "campaign-artifact-admission-decision/v1"},
        "classification": {"enum": ["admitted-new-schema", "historical-pre-admission-schema"]},
        "admission_status": {"enum": ["admitted", "historical-not-reclassified"]},
        "verification_status": {"const": "not-evaluated-by-overlay"},
        "campaign_id": {"type": "string", "minLength": 1},
        "campaign_path": {"type": "string", "minLength": 1},
        "campaign_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "wal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "attempt_receipt_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "validator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "sha256"],
          "properties": {
            "identity": {"const": "orchestrator.campaign.artifact_admission"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "overlay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ledger_sha256", "record_key"],
          "properties": {
            "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "record_key": {"type": ["string", "null"]}
          }
        }
      }
    },
    "campaign_verifier_epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_verifier_epoch", "state", "reason_code", "identity_scope", "excluded_scope"],
      "properties": {
        "campaign_verifier_epoch": {"type": "string", "pattern": "^(E0|E1:[0-9a-f]{64})$"},
        "state": {"enum": ["E0", "E1", "E1-stale"]},
        "reason_code": {"enum": ["v1-authority-absent", "recorded-closure", "recorded-current-closure-mismatch", "current-closure-unavailable"]},
        "identity_scope": {"type": "string", "minLength": 1},
        "excluded_scope": {"type": "string", "minLength": 1}
      }
    },
    "acceptance_receipt": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
      ]
    },
    "certifying_input": {"type": "boolean"},
    "mechanism_hypotheses": {"type": "array", "maxItems": 0, "description": "原料配線設計 = docs/ 側の設計文書に従い、実装時に v3 へ上げる"}
  },
  "definitions": {
    "wal_ref": {"type": "string", "pattern": "^wal:[0-9a-f]{64}$"},
    "floor_source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "floor_result": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["value", "provenance", "source", "search"], "properties": {"value": {"type": "object"}, "provenance": {"const": "env-record"}, "source": {"$ref": "#/definitions/floor_source"}, "search": {"type": "null"}}},
        {"type": "object", "additionalProperties": false, "required": ["value", "provenance", "source", "search"], "properties": {"value": {"type": "null"}, "provenance": {"const": "no-matching-env-record"}, "source": {"type": "null"}, "search": {"type": "object"}}}
      ]
    }
  }
}
