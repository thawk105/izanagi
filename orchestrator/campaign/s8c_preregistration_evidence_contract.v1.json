{
  "schema_version": "s8c-preregistration-evidence-contract/v1",
  "conditions": [
    {
      "condition_number": 1,
      "required_evidence": [
        {
          "artifact_kind": "workload_supervisor",
          "path": "orchestrator/campaign/p3_autonomous_workload_trial.py",
          "field_paths": [
            "_campaign_for.search_config.records",
            "_campaign_for.search_config.threads",
            "_perf_for.records",
            "_perf_for.threads",
            "_descriptor_for.projected_input.records",
            "_descriptor_for.projected_input.threads"
          ],
          "reachable_from": [
            "main -> run_trial -> _run_workload -> _campaign_for",
            "main -> run_trial -> _run_workload -> _perf_for",
            "main -> run_trial -> _run_workload -> _descriptor_for"
          ]
        },
        {
          "artifact_kind": "ratified_generation_reference",
          "path": "orchestrator/campaign/s8b_ratified_freeze.py",
          "field_paths": [
            "load_ratified_freeze().sha256",
            "load_ratified_freeze().holdouts"
          ],
          "reachable_from": [
            "run_trial -> _run_workload -> load_ratified_freeze"
          ]
        }
      ],
      "consumer_requirement": {
        "path": "orchestrator/campaign/p3_autonomous_workload_trial.py",
        "entrypoints": ["main", "run_trial"],
        "proof": "The same ratified-generation hash and workload projection must reach all three production configuration sinks; helper names or probe-only return values are insufficient."
      },
      "negative_control_id": "nc_c01_perf_scale_regression",
      "machine_checkable": true,
      "static_only_note": "Only committed source reachability, constant projections, and a pre-run ratified-generation reference are inspected; no run output is required."
    },
    {
      "condition_number": 2,
      "required_evidence": [
        {
          "artifact_kind": "trial_registry",
          "path": "orchestrator/campaign/trial_registry.py",
          "field_paths": [
            "TrialArmExecutionBinding.input_schema_version",
            "TrialArmExecutionBinding.content_digest_sha256",
            "TrialArmExecutionBinding.arm_binding_digest_sha256",
            "run_start.arm_execution",
            "terminal_report.arm_execution",
            "terminal_report.cells[*].descriptor",
            "terminal_report.cells[*].descriptor_binding"
          ],
          "reachable_from": [
            "bind_trial_arm -> resolve_arm_input",
            "assert_issued_trial_arm_execution -> assert_issued_trial_binding",
            "assert_issued_trial_arm_execution -> assert_issued_resolved_arm_input",
            "assert_rederived_trial_arm_execution -> assert_issued_trial_arm_execution -> bind_trial_arm",
            "assert_trial_registry_acceptance -> _expected_registered_arm_execution_record -> resolve_arm_input",
            "assert_trial_registry_acceptance -> validate_execution_input_descriptor",
            "assert_trial_registry_acceptance -> assert_execution_digest_chain"
          ]
        },
        {
          "artifact_kind": "proposal_namespace_producer",
          "path": "orchestrator/campaign/p3_autonomous_workload_trial.py",
          "field_paths": [
            "_invocation_namespace.arm",
            "_invocation_namespace.digest",
            "_invocation_id.arm",
            "_invocation_id.digest",
            "_run_workload.proposal_path",
            "_run_workload.proposal.arm_binding_digest_sha256"
          ],
          "reachable_from": [
            "_invocation_id -> _invocation_namespace -> provider invocation_id",
            "_run_workload -> _invocation_namespace -> proposal_path",
            "run_trial -> _invocation_namespace -> invocation namespace"
          ]
        }
      ],
      "consumer_requirement": {
        "path": "orchestrator/campaign/trial_registry.py",
        "entrypoints": ["bind_trial_arm", "assert_trial_registry_acceptance"],
        "proof": "The registry must prove injective arm binding at production sinks, not merely store a declared arm field."
      },
      "negative_control_id": "nc_c02_proposal_path_arm_collision",
      "machine_checkable": true,
      "static_only_note": "Only committed registry call edges and arm/digest consumption by the shared invocation and proposal namespace constructor are inspected; receipt v2 proves completed-run bytes separately."
    },
    {
      "condition_number": 3,
      "required_evidence": [
        {
          "artifact_kind": "trial_manifest",
          "path": "output/s8c-preregistration/trial-manifest.v1.json",
          "field_paths": [
            "schema_version",
            "cells[*].trial_id",
            "cells[*].arm",
            "cells[*].holdout",
            "cells[*].campaign_id"
          ],
          "reachable_from": [
            "run_trial -> load_manifest -> admit_manifest_cell",
            "accept_trial -> compare_registry_to_manifest"
          ]
        },
        {
          "artifact_kind": "prereg_effective_binding",
          "path": "output/s8c-preregistration/prereg-effective-binding.v1.json",
          "field_paths": [
            "prereg_content_commit",
            "manifest_path",
            "manifest_sha256"
          ],
          "reachable_from": [
            "run_trial -> registry preflight -> verify effective binding",
            "accept_trial -> compare registry to effective binding"
          ]
        },
        {
          "artifact_kind": "trial_registry",
          "path": "orchestrator/campaign/trial_registry.py",
          "field_paths": [
            "registry.manifest_sha256",
            "registry.prereg_content_commit",
            "registry.prereg_effective_commit",
            "registry.trials[*]",
            "registry.history_prefix_sha256"
          ],
          "reachable_from": [
            "run_trial -> registry preflight",
            "accept_trial -> append-only registry append"
          ]
        }
      ],
      "consumer_requirement": {
        "path": "orchestrator/campaign/trial_registry.py",
        "entrypoints": ["load_manifest", "accept_trial"],
        "proof": "A strict manifest loader and append-only registry consumer must cross-check the exact pre-run manifest cell set, the effective-binding record, and the registry, rejecting omissions, extras, or mismatched content and effective commits."
      },
      "negative_control_id": "nc_c03_manifest_cell_removed",
      "machine_checkable": false,
      "static_only_note": "Manifest bytes and the current registry module are pre-run facts, but the two-stage content/effective binding capability is not yet implemented."
    },
    {
      "condition_number": 4,
      "required_evidence": [
        {
          "artifact_kind": "workload_supervisor",
          "path": "orchestrator/campaign/p3_autonomous_workload_trial.py",
          "field_paths": [
            "run_trial.crash_handler.experiment_status",
            "run_trial.crash_handler.remaining_cells"
          ],
          "reachable_from": [
            "main -> run_trial -> crash handler -> mark_experiment_indeterminate"
          ]
        },
        {
          "artifact_kind": "trial_registry",
          "path": "orchestrator/campaign/trial_registry.py",
          "field_paths": [
            "trial_lifecycle.started_once",
            "trial_lifecycle.restart_forbidden"
          ],
          "reachable_from": [
            "run_trial crash handler -> forbid_trial_restart",
            "run_trial preflight -> reject_started_trial"
          ]
        }
      ],
      "consumer_requirement": {
        "path": "orchestrator/campaign/p3_autonomous_workload_trial.py",
        "entrypoints": ["main", "run_trial"],
        "proof": "The caught production crash path must mark the whole experiment indeterminate and invoke the registry's no-restart consumer before returning."
      },
      "negative_control_id": "nc_c04_partial_crash_survives",
      "machine_checkable": true,
      "static_only_note": "The check follows committed exception-handling and registry call paths; it does not require an actual crash or terminal report."
    },
    {
      "condition_number": 5,
      "required_evidence": [
        {
          "artifact_kind": "schedule_artifact",
          "path": "output/s8c-preregistration/schedule.v1.json",
          "field_paths": [
            "schema_version",
            "master_seed",
            "cells[*].schedule_index",
            "cells[*].arm",
            "cells[*].holdout",
            "cells[*].search_space_sha256",
            "cells[*].initial_state_sha256"
          ],
          "reachable_from": [
            "run_trial -> load_schedule -> launch next cell"
          ]
        },
        {
          "artifact_kind": "schedule_consumer",
          "path": "orchestrator/campaign/s8c_schedule.py",
          "field_paths": [
            "regenerate(master_seed)",
            "verify_exact_schedule_bytes",
            "verify_shared_search_space_and_initial_state"
          ],
          "reachable_from": [
            "run_trial -> verify_schedule -> consume_schedule"
          ]
        }
      ],
      "consumer_requirement": {
        "path": "orchestrator/campaign/s8c_schedule.py",
        "entrypoints": ["verify_schedule", "consume_schedule"],
        "proof": "The production launcher must consume the independently regenerated byte-exact schedule and shared starting-state hashes."
      },
      "negative_control_id": "nc_c05_initial_state_hash_bitflip",
      "machine_checkable": true,
      "static_only_note": "The schedule is required to be committed before launch; no observed order or post-run artifact is accepted as readiness evidence."
    },
    {
      "condition_number": 6,
      "required_evidence": [
        {
          "artifact_kind": "budget_consumer",
          "path": "orchestrator/campaign/s8c_budget.py",
          "field_paths": [
            "ledger.manifest_sha256",
            "ledger.freeze_sha256",
            "ledger.schedule_sha256",
            "ledger.ratified_generation_sha256",
            "reservation.cells[*].reserved_bench_s",
            "settlement.cells[*].actual_bench_s"
          ],
          "reachable_from": [
            "run_trial -> reserve_all_cells -> bench launch",
            "bench terminal -> settle -> symmetric_indeterminate"
          ]
        },
        {
          "artifact_kind": "ratified_generation_reference",
          "path": "orchestrator/campaign/s8b_ratified_freeze.py",
          "field_paths": ["load_ratified_freeze().sha256"],
          "reachable_from": [
            "run_trial -> load_ratified_freeze -> reserve_all_cells"
          ]
        }
      ],
      "consumer_requirement": {
        "path": "orchestrator/campaign/s8c_budget.py",
        "entrypoints": ["reserve_all_cells", "settle", "symmetric_indeterminate"],
        "proof": "All cells must be reserved before any bench launch, actual bench seconds must be settled, and insufficiency must stop unrun arms symmetrically."
      },
      "negative_control_id": "nc_c06_one_arm_reservation_removed",
      "machine_checkable": true,
      "static_only_note": "Only the committed reservation/settlement consumer and its pre-run bindings are readiness evidence; spent values from a completed run are not required."
    },
    {
      "condition_number": 7,
      "required_evidence": [
        {
          "artifact_kind": "result_judge",
          "path": "orchestrator/campaign/s8c_result_judge.py",
          "field_paths": [
            "floor_refs[*].path",
            "floor_refs[*].sha256",
            "floor_refs[*].env_tag",
            "floor_refs[*].measurement_head",
            "judge.conditions",
            "result_table.cells[*]"
          ],
          "reachable_from": [
            "verify_floor_bytes -> judge -> publish_result_table"
          ]
        },
        {
          "artifact_kind": "ratified_generation_reference",
          "path": "orchestrator/campaign/s8b_ratified_freeze.py",
          "field_paths": ["load_ratified_freeze().sha256"],
          "reachable_from": [
            "load_ratified_freeze -> verify_floor_bytes"
          ]
        }
      ],
      "consumer_requirement": {
        "path": "orchestrator/campaign/s8c_result_judge.py",
        "entrypoints": ["verify_floor_bytes", "judge", "publish_result_table"],
        "proof": "The formal acceptance consumer must verify both floor artifacts, evaluate exactly three judge conditions, and require the exact predeclared result-cell set."
      },
      "negative_control_id": "nc_c07_floor_or_result_cell_removed",
      "machine_checkable": true,
      "static_only_note": "Readiness checks schemas, floor references, and consumer reachability; it does not demand result values that only exist after execution."
    },
    {
      "condition_number": 8,
      "required_evidence": [
        {
          "artifact_kind": "trial_manifest",
          "path": "output/s8c-preregistration/trial-manifest.v1.json",
          "field_paths": [
            "schema_version",
            "cells[*].trial_id",
            "cells[*].arm",
            "cells[*].holdout",
            "cells[*].campaign_id"
          ],
          "reachable_from": [
            "run_trial -> historical manifest preflight",
            "accept_trial -> historical manifest reread"
          ]
        },
        {
          "artifact_kind": "prereg_effective_binding",
          "path": "output/s8c-preregistration/prereg-effective-binding.v1.json",
          "field_paths": [
            "prereg_content_commit",
            "manifest_path",
            "manifest_sha256"
          ],
          "reachable_from": [
            "run_trial -> effective binding preflight",
            "accept_trial -> historical binding reread"
          ]
        },
        {
          "artifact_kind": "trial_registry",
          "path": "orchestrator/campaign/trial_registry.py",
          "field_paths": [
            "run_start.prereg_content_commit",
            "run_start.prereg_effective_commit",
            "terminal_report.prereg_content_commit",
            "terminal_report.prereg_effective_commit",
            "registry.prereg_content_commit",
            "registry.prereg_effective_commit",
            "measurement_head"
          ],
          "reachable_from": [
            "effective binding -> run start",
            "accept_trial -> exact parent-set and measurement ancestry verification"
          ]
        }
      ],
      "consumer_requirement": {
        "path": "orchestrator/campaign/trial_registry.py",
        "entrypoints": ["admit_preregistration", "accept_trial"],
        "proof": "Admission and acceptance must require the effective commit C to have the exact parent set {P}, match P's manifest blob to the binding digest, and prove ancestry from C to the measurement HEAD."
      },
      "negative_control_id": "nc_c08_parent_commit_substitution",
      "machine_checkable": false,
      "static_only_note": "The manifest and current registry module are pre-run facts, but the two-stage content/effective binding and exact-parent verifier are not yet implemented."
    },
    {
      "condition_number": 9,
      "required_evidence": [
        {
          "artifact_kind": "layer3_producer",
          "path": "orchestrator/campaign/p3_autonomous_workload_trial.py",
          "field_paths": ["run_trial.pre_publish_layer3_verification"],
          "reachable_from": [
            "main -> run_trial -> assert_campaign_layer3_chain -> report publish"
          ]
        },
        {
          "artifact_kind": "trial_registry",
          "path": "orchestrator/campaign/trial_registry.py",
          "field_paths": [
            "assert_trial_registry_acceptance.build_reports[*].layer3_chain",
            "assert_trial_registry_acceptance.no_build.certifying"
          ],
          "reachable_from": [
            "assert_trial_registry_acceptance -> assert_campaign_layer3_chain -> registry append"
          ]
        }
      ],
      "consumer_requirement": {
        "path": "orchestrator/campaign/trial_registry.py",
        "entrypoints": ["assert_trial_registry_acceptance"],
        "proof": "The formal registry authority must execute Layer 3 verification for every build report and must never certify a missing or no-build chain."
      },
      "negative_control_id": "nc_c09_acceptance_skips_layer3",
      "machine_checkable": true,
      "static_only_note": "Static call reachability in producer and formal acceptance is sufficient; no persisted Layer 3 report from a completed run is required."
    },
    {
      "condition_number": 10,
      "required_evidence": [
        {
          "artifact_kind": "cross_binding_verifier",
          "path": "orchestrator/campaign/autonomous_trial_completeness.py",
          "field_paths": [
            "role_event.input_payload_sha256",
            "role_event.raw_response_path",
            "role_event.raw_response_sha256",
            "provider.payload_sha256",
            "provider.envelope_sha256",
            "proposal.path",
            "proposal.sha256",
            "proposal.build_source_bindings",
            "campaign_wal.build_records",
            "campaign_wal.bench_records",
            "layer3.artifact_refs",
            "layer3.source_refs",
            "layer3.admission_decision"
          ],
          "reachable_from": [
            "assert_trial_registry_acceptance -> verify_s8c_cross_binding -> authoritative bytes reread"
          ]
        },
        {
          "artifact_kind": "trial_registry",
          "path": "orchestrator/campaign/trial_registry.py",
          "field_paths": ["assert_trial_registry_acceptance.cross_binding_receipt_sha256"],
          "reachable_from": [
            "assert_trial_registry_acceptance -> verify_s8c_cross_binding -> registry append"
          ]
        }
      ],
      "consumer_requirement": {
        "path": "orchestrator/campaign/trial_registry.py",
        "entrypoints": ["assert_trial_registry_acceptance"],
        "proof": "One authoritative verifier must reread every referenced byte stream and bind supervisor, provider, proposal, WAL, bench, and Layer 3 fields before registry acceptance."
      },
      "negative_control_id": "nc_c10_raw_response_unbound",
      "machine_checkable": true,
      "static_only_note": "Readiness requires the verifier and acceptance call path, not a completed run's mutable artifact set."
    },
    {
      "condition_number": 11,
      "required_evidence": [
        {
          "artifact_kind": "generation_supervisor",
          "path": "orchestrator/campaign/p3_autonomous_workload_trial.py",
          "field_paths": [
            "MAX_APPROVED_GENERATIONS",
            "main.args.max_generations",
            "run_trial.generations",
            "_run_workload.generations",
            "_run_workload.apply_critic_feedback"
          ],
          "reachable_from": [
            "main -> run_trial -> _run_workload -> apply_critic_feedback -> next generation"
          ]
        },
        {
          "artifact_kind": "generation_projection",
          "path": "orchestrator/campaign/s8c_generation_projection.py",
          "field_paths": [
            "_CRITIC_KEYS",
            "_DIAGNOSTIC_METRICS",
            "apply_critic_feedback",
            "_validate_critic_projection",
            "validate_planner_payload"
          ],
          "reachable_from": [
            "apply_critic_feedback -> AppliedCriticFeedback.planner_projection",
            "validate_planner_payload -> _validate_critic_projection"
          ]
        }
      ],
      "consumer_requirement": {
        "path": "orchestrator/campaign/p3_autonomous_workload_trial.py",
        "entrypoints": ["main", "run_trial", "_run_workload"],
        "proof": "Compliance requires the approved generation upper bound at all three entry boundaries and the closed critic projection to be consumed by the next generation. Exact G=2 remains a launch-shape responsibility normatively specified by preregistration sections 4 and 7; the upper bound does not enforce a generation minimum."
      },
      "negative_control_id": "nc_c11_generation_cap_reverts_to_one",
      "machine_checkable": true,
      "static_only_note": "The check uses the committed upper-bound validators, closed critic projection, and production consumer path; it does not depend on retired policy artifacts or treat a ruling or observed run as compliance."
    },
    {
      "condition_number": 12,
      "required_evidence": [
        {
          "artifact_kind": "workload_supervisor",
          "path": "orchestrator/campaign/p3_autonomous_workload_trial.py",
          "field_paths": [
            "run_trial.env_contract",
            "run_trial.calibration_receipt"
          ],
          "reachable_from": [
            "main -> run_trial -> env_contract.lookup",
            "run_trial -> execution_guard.attest_and_build_receipt",
            "run_trial -> reservation.read_binding -> reservation.check_reservation -> campaign launch"
          ]
        },
        {
          "artifact_kind": "environment_contract",
          "path": "orchestrator/campaign/env_contract.py",
          "field_paths": [
            "lookup(env_tag)",
            "ExecutionEnvironmentContract.calibration_ref"
          ],
          "reachable_from": [
            "run_trial -> lookup -> attestation consumer"
          ]
        },
        {
          "artifact_kind": "execution_guard",
          "path": "orchestrator/campaign/execution_guard.py",
          "field_paths": ["attest_and_build_receipt(contract, verified_calibration)"],
          "reachable_from": [
            "run_trial -> attest_and_build_receipt -> campaign launch"
          ]
        },
        {
          "artifact_kind": "allocation_consumer",
          "path": "orchestrator/campaign/reservation.py",
          "field_paths": [
            "ReservationBinding.job_id",
            "ReservationBinding.boot_id",
            "ReservationBinding.deadline_epoch",
            "read_binding(environ)",
            "check_reservation(binding, required_s, safety_margin_s, environ)"
          ],
          "reachable_from": [
            "run_trial -> reservation.read_binding -> reservation.check_reservation -> campaign launch"
          ]
        }
      ],
      "consumer_requirement": {
        "path": "orchestrator/campaign/p3_autonomous_workload_trial.py",
        "entrypoints": ["main", "run_trial"],
        "proof": "The production 8c launcher must consume the registered environment and calibration attestations plus a reservation binding, and before launch reject a mismatched PBS job, a mismatched boot, or insufficient time remaining before the reservation deadline."
      },
      "negative_control_id": "nc_c12_reservation_check_bypassed",
      "machine_checkable": true,
      "static_only_note": "Only committed top-level definitions and may-reach call names are checked; no live allocation or post-run environment observation is required. This may-reach check does not prove same-binding data flow, dominance before campaign launch, or that exceptions are not swallowed. It does not establish process exclusivity or resume rejection."
    }
  ]
}
