        "trace_enabled": {"const": true},
        "analysis_enabled": {"const": true},
        "cmake_cache": {"$ref": "#/definitions/correctnessCmakeCache"},
        "compile_commands": {"$ref": "#/definitions/fileRecord"}
      }
