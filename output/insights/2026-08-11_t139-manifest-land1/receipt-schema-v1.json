    "correctnessEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "arm", "workload", "build", "run_scope", "outputs"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "arm": {"enum": ["stock", "mode1", "modeX"]},
        "workload": {"enum": ["W1", "W2"]},
        "build": {"$ref": "#/definitions/correctnessBuild"},
        "run_scope": {"$ref": "#/definitions/runScope"},
        "outputs": {
          "type": "array",
          "items": {"$ref": "#/definitions/fileRecord"}
        }
      }
