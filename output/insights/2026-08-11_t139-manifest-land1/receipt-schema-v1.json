{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "hex40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000\\r\\n])(?!.*\/$).+$"
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"$ref": "#/definitions/repoPath"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/definitions/hex64"}
      }
    },
    "blobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commit", "sha256"],
      "properties": {
        "path": {"$ref": "#/definitions/repoPath"},
        "commit": {"$ref": "#/definitions/hex40"},
        "sha256": {"$ref": "#/definitions/hex64"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_commit", "ccbench_pin", "base_tree_sha", "patch_path", "patch_sha256"],
      "properties": {
        "repo_commit": {"$ref": "#/definitions/hex40"},
        "ccbench_pin": {"$ref": "#/definitions/hex40"},
        "base_tree_sha": {"$ref": "#/definitions/hex40"},
        "patch_path": {"type": ["string", "null"]},
        "patch_sha256": {
          "anyOf": [
            {"$ref": "#/definitions/hex64"},
            {"type": "null"}
          ]
        }
      }
    },
    "performanceCmakeCache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace", "add_analysis"],
      "properties": {
        "trace": {"type": "integer", "enum": [0]},
        "add_analysis": {"type": "integer", "enum": [0]}
      }
    },
    "correctnessCmakeCache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace", "add_analysis"],
      "properties": {
        "trace": {"type": "integer", "enum": [1]},
        "add_analysis": {"type": "integer", "enum": [1]}
      }
    },
    "translationUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized_argv", "sha256"],
      "properties": {
        "normalized_argv": {
          "type": "array",
          "items": {"type": "string"}
        },
        "sha256": {"$ref": "#/definitions/hex64"}
      }
    },
    "translationUnits": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "patternProperties": {
        "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000\\r\\n])(?!.*\/$).+$": {
          "$ref": "#/definitions/translationUnit"
        }
      }
    },
    "performanceCompileStock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mode_macro",
        "configure_argv",
        "translation_units",
        "identity_sha256",
        "trace_enabled",
        "analysis_enabled",
        "cmake_cache",
        "compile_commands"
      ],
      "properties": {
        "source": {
          "allOf": [
            {"$ref": "#/definitions/source"},
            {
              "properties": {
                "patch_path": {"type": "null"},
                "patch_sha256": {"type": "null"}
              },
              "required": ["patch_path", "patch_sha256"]
            }
          ]
        },
        "mode_macro": {"type": "null"},
        "configure_argv": {
          "type": "array",
          "items": {"type": "string"}
        },
        "translation_units": {"$ref": "#/definitions/translationUnits"},
        "identity_sha256": {"$ref": "#/definitions/hex64"},
        "trace_enabled": {"const": false},
        "analysis_enabled": {"const": false},
        "cmake_cache": {"$ref": "#/definitions/performanceCmakeCache"},
        "compile_commands": {"$ref": "#/definitions/fileRecord"}
      }
    },
    "performanceCompileMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mode_macro",
        "configure_argv",
        "translation_units",
        "identity_sha256",
        "trace_enabled",
        "analysis_enabled",
        "cmake_cache",
        "compile_commands"
      ],
      "properties": {
        "source": {
          "allOf": [
            {"$ref": "#/definitions/source"},
            {
              "properties": {
                "patch_path": {"type": "string"},
                "patch_sha256": {"$ref": "#/definitions/hex64"}
              },
              "required": ["patch_path", "patch_sha256"]
            }
          ]
        },
        "mode_macro": {"type": "string"},
        "configure_argv": {
          "type": "array",
          "items": {"type": "string"}
        },
        "translation_units": {"$ref": "#/definitions/translationUnits"},
        "identity_sha256": {"$ref": "#/definitions/hex64"},
        "trace_enabled": {"const": false},
        "analysis_enabled": {"const": false},
        "cmake_cache": {"$ref": "#/definitions/performanceCmakeCache"},
        "compile_commands": {"$ref": "#/definitions/fileRecord"}
      }
    },
    "immutableArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "size", "sha256"],
      "properties": {
        "artifact_path": {"$ref": "#/definitions/repoPath"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/definitions/hex64"}
      }
    },
    "dynamicDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soname", "resolved_path", "sha256"],
      "properties": {
        "soname": {"type": "string"},
        "resolved_path": {"type": "string"},
        "sha256": {"$ref": "#/definitions/hex64"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler_path",
        "compiler_version",
        "compiler_sha256",
        "link_argv",
        "dynamic_deps",
        "elf_interpreter"
      ],
      "properties": {
        "compiler_path": {"type": "string"},
        "compiler_version": {"type": "string"},
        "compiler_sha256": {"$ref": "#/definitions/hex64"},
        "link_argv": {
          "type": "array",
          "items": {"type": "string"}
        },
        "dynamic_deps": {
          "type": "array",
          "items": {"$ref": "#/definitions/dynamicDependency"}
        },
        "elf_interpreter": {"type": "string"}
      }
    },
    "stockArm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compile", "binary", "built_outside_allocation", "toolchain"],
      "properties": {
        "compile": {"$ref": "#/definitions/performanceCompileStock"},
        "binary": {"$ref": "#/definitions/fileRecord"},
        "built_outside_allocation": {"$ref": "#/definitions/immutableArtifact"},
        "toolchain": {"$ref": "#/definitions/toolchain"}
      }
    },
    "modeArm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compile", "binary", "built_outside_allocation", "toolchain"],
      "properties": {
        "compile": {"$ref": "#/definitions/performanceCompileMode"},
        "binary": {"$ref": "#/definitions/fileRecord"},
        "built_outside_allocation": {"$ref": "#/definitions/immutableArtifact"},
        "toolchain": {"$ref": "#/definitions/toolchain"}
      }
    },
    "erratum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["erratum_id", "path", "commit", "sha256", "approval_fold_commit"],
      "properties": {
        "erratum_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "path": {"$ref": "#/definitions/repoPath"},
        "commit": {"$ref": "#/definitions/hex40"},
        "sha256": {"$ref": "#/definitions/hex64"},
        "approval_fold_commit": {"$ref": "#/definitions/hex40"}
      }
    },
    "preregistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core",
        "addendum_a",
        "addendum_b",
        "fold_commit",
        "errata",
        "approval_manifest",
        "receipt_schema",
        "composed_core_sha256"
      ],
      "properties": {
        "core": {"$ref": "#/definitions/blobRef"},
        "addendum_a": {"$ref": "#/definitions/blobRef"},
        "addendum_b": {
          "anyOf": [
            {"$ref": "#/definitions/blobRef"},
            {"type": "null"}
          ]
        },
        "fold_commit": {"$ref": "#/definitions/hex40"},
        "errata": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/erratum"}
        },
        "approval_manifest": {"$ref": "#/definitions/blobRef"},
        "receipt_schema": {"$ref": "#/definitions/blobRef"},
        "composed_core_sha256": {"$ref": "#/definitions/hex64"}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "profile_kind", "schema_version", "raw"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "profile_kind": {"enum": ["expected", "observed"]},
        "schema_version": {"type": "string"},
        "raw": {"$ref": "#/definitions/fileRecord"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env_tag", "attestation_mode", "attestations"],
      "properties": {
        "env_tag": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "attestation_mode": {"const": "required"},
        "attestations": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/definitions/attestation"},
          "contains": {
            "properties": {"profile_kind": {"const": "expected"}},
            "required": ["profile_kind"]
          },
          "allOf": [
            {
              "contains": {
                "properties": {"profile_kind": {"const": "observed"}},
                "required": ["profile_kind"]
              }
            }
          ]
        }
      }
    },
    "measurementCheckout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_head", "ccbench_head"],
      "properties": {
        "repository_head": {"$ref": "#/definitions/hex40"},
        "ccbench_head": {"$ref": "#/definitions/hex40"}
      }
    },
    "dependencyPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "commit"],
      "properties": {
        "name": {"enum": ["gflags", "glog", "masstree", "mimalloc", "googletest"]},
        "commit": {"$ref": "#/definitions/hex40"}
      }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stock", "mode1", "modeX"],
      "properties": {
        "stock": {"$ref": "#/definitions/stockArm"},
        "mode1": {"$ref": "#/definitions/modeArm"},
        "modeX": {"$ref": "#/definitions/modeArm"}
      }
    },
    "exclusivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "raw"],
      "properties": {
        "method": {"enum": ["node_local_process_scan", "scheduler_accounting"]},
        "raw": {"$ref": "#/definitions/fileRecord"}
      }
    },
    "phaseCap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "cap_s", "sub_cap_s_or_null"],
      "properties": {
        "phase": {"enum": ["preflight", "observation", "decision", "marker", "run", "teardown"]},
        "cap_s": {"type": "integer"},
        "sub_cap_s_or_null": {"type": ["integer", "null"]}
      }
    },
    "phaseEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "event", "monotonic_ns"],
      "properties": {
        "phase": {"enum": ["preflight", "observation", "decision", "marker", "run", "teardown"]},
        "event": {"enum": ["enter", "leave", "term_signal"]},
        "monotonic_ns": {"type": "integer", "minimum": 0}
      }
    },
    "binaryRehash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point", "arm", "sha256", "monotonic_ns"],
      "properties": {
        "point": {"enum": ["after_staging", "before_first_run", "after_last_run"]},
        "arm": {"enum": ["stock", "mode1", "modeX"]},
        "sha256": {"$ref": "#/definitions/hex64"},
        "monotonic_ns": {"type": "integer", "minimum": 0}
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_id",
        "allocation_role",
        "cluster_slot_or_null",
        "scheduler_request_id",
        "path_choice",
        "path_choice_intent",
        "node",
        "requested_walltime_s",
        "internal_deadline_s",
        "started_at_monotonic_ns",
        "ended_at_monotonic_ns",
        "accounting_trace",
        "exclusivity",
        "phase_caps",
        "phase_events",
        "binary_rehash"
      ],
      "properties": {
        "allocation_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "allocation_role": {"enum": ["performance_cluster", "verification"]},
        "cluster_slot_or_null": {"type": ["integer", "null"]},
        "scheduler_request_id": {"type": "string"},
        "path_choice": {"enum": ["primary_build_outside", "fallback_build_inside"]},
        "path_choice_intent": {"$ref": "#/definitions/fileRecord"},
        "node": {"type": "string"},
        "requested_walltime_s": {"type": "integer", "minimum": 1},
        "internal_deadline_s": {"type": "integer", "minimum": 1},
        "started_at_monotonic_ns": {"type": "integer", "minimum": 0},
        "ended_at_monotonic_ns": {"type": "integer", "minimum": 0},
        "accounting_trace": {"$ref": "#/definitions/fileRecord"},
        "exclusivity": {"$ref": "#/definitions/exclusivity"},
        "phase_caps": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/definitions/phaseCap"},
          "allOf": [
            {"contains": {"properties": {"phase": {"const": "preflight"}}, "required": ["phase"]}},
            {"contains": {"properties": {"phase": {"const": "observation"}}, "required": ["phase"]}},
            {"contains": {"properties": {"phase": {"const": "decision"}}, "required": ["phase"]}},
            {"contains": {"properties": {"phase": {"const": "marker"}}, "required": ["phase"]}},
            {"contains": {"properties": {"phase": {"const": "run"}}, "required": ["phase"]}},
            {"contains": {"properties": {"phase": {"const": "teardown"}}, "required": ["phase"]}}
          ]
        },
        "phase_events": {
          "type": "array",
          "items": {"$ref": "#/definitions/phaseEvent"}
        },
        "binary_rehash": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {"$ref": "#/definitions/binaryRehash"},
          "allOf": [
            {"contains": {"properties": {"point": {"const": "after_staging"}, "arm": {"const": "stock"}}, "required": ["point", "arm"]}},
            {"contains": {"properties": {"point": {"const": "after_staging"}, "arm": {"const": "mode1"}}, "required": ["point", "arm"]}},
            {"contains": {"properties": {"point": {"const": "after_staging"}, "arm": {"const": "modeX"}}, "required": ["point", "arm"]}},
            {"contains": {"properties": {"point": {"const": "before_first_run"}, "arm": {"const": "stock"}}, "required": ["point", "arm"]}},
            {"contains": {"properties": {"point": {"const": "before_first_run"}, "arm": {"const": "mode1"}}, "required": ["point", "arm"]}},
            {"contains": {"properties": {"point": {"const": "before_first_run"}, "arm": {"const": "modeX"}}, "required": ["point", "arm"]}},
            {"contains": {"properties": {"point": {"const": "after_last_run"}, "arm": {"const": "stock"}}, "required": ["point", "arm"]}},
            {"contains": {"properties": {"point": {"const": "after_last_run"}, "arm": {"const": "mode1"}}, "required": ["point", "arm"]}},
            {"contains": {"properties": {"point": {"const": "after_last_run"}, "arm": {"const": "modeX"}}, "required": ["point", "arm"]}}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"allocation_role": {"const": "performance_cluster"}},
            "required": ["allocation_role"]
          },
          "then": {
            "properties": {
              "cluster_slot_or_null": {"type": "integer", "minimum": 1, "maximum": 13}
            },
            "required": ["cluster_slot_or_null"]
          },
          "else": {
            "properties": {"cluster_slot_or_null": {"type": "null"}},
            "required": ["cluster_slot_or_null"]
          }
        },
        {
          "if": {
            "properties": {"allocation_role": {"const": "verification"}},
            "required": ["allocation_role"]
          },
          "then": {
            "properties": {"requested_walltime_s": {"const": 3600}},
            "required": ["requested_walltime_s"]
          },
          "else": {
            "if": {
              "properties": {"path_choice": {"const": "primary_build_outside"}},
              "required": ["path_choice"]
            },
            "then": {
              "properties": {"requested_walltime_s": {"const": 3600}},
              "required": ["requested_walltime_s"]
            },
            "else": {
              "properties": {"requested_walltime_s": {"const": 5400}},
              "required": ["requested_walltime_s"]
            }
          }
        }
      ]
    },
    "effectiveFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clocks_per_us",
        "epoch_time",
        "extime",
        "thread_num",
        "ycsb_max_ope",
        "ycsb_rmw",
        "ycsb_rratio",
        "ycsb_tuple_num",
        "ycsb_zipf_skew"
      ],
      "properties": {
        "clocks_per_us": {},
        "epoch_time": {},
        "extime": {},
        "thread_num": {},
        "ycsb_max_ope": {},
        "ycsb_rmw": {},
        "ycsb_rratio": {},
        "ycsb_tuple_num": {},
        "ycsb_zipf_skew": {}
      }
    },
    "optParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ADD_ANALYSIS",
        "BACK_OFF",
        "KEY_SIZE",
        "MASSTREE_USE",
        "NO_WAIT_LOCKING_IN_VALIDATION",
        "PARTITION_TABLE",
        "PROCEDURE_SORT",
        "SLEEP_READ_PHASE",
        "VAL_SIZE",
        "WAL"
      ],
      "properties": {
        "ADD_ANALYSIS": {"type": "integer"},
        "BACK_OFF": {"type": "integer"},
        "KEY_SIZE": {"type": "integer"},
        "MASSTREE_USE": {"type": "integer"},
        "NO_WAIT_LOCKING_IN_VALIDATION": {"type": "integer"},
        "PARTITION_TABLE": {"type": "integer"},
        "PROCEDURE_SORT": {"type": "integer"},
        "SLEEP_READ_PHASE": {"type": "integer"},
        "VAL_SIZE": {"type": "integer"},
        "WAL": {"type": "integer"}
      }
    },
    "workloadPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver_argv", "effective_flags", "opt_parameters"],
      "properties": {
        "driver_argv": {
          "type": "array",
          "items": {"type": "string"}
        },
        "effective_flags": {"$ref": "#/definitions/effectiveFlags"},
        "opt_parameters": {"$ref": "#/definitions/optParameters"}
      }
    },
    "workloads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["W1", "W2"],
      "properties": {
        "W1": {"$ref": "#/definitions/workloadPlan"},
        "W2": {"$ref": "#/definitions/workloadPlan"}
      }
    },
    "clusterSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_slot", "workload", "block_index", "permutation"],
      "properties": {
        "cluster_slot": {"type": "integer", "minimum": 1, "maximum": 13},
        "workload": {"enum": ["W1", "W2"]},
        "block_index": {"type": "integer", "minimum": 1, "maximum": 12},
        "permutation": {"enum": ["SDX", "SXD", "DSX", "DXS", "XSD", "XDS"]}
      }
    },
    "plannedWait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "required_s"],
      "properties": {
        "kind": {"enum": ["none", "arm_gap", "block_gap", "workload_switch"]},
        "required_s": {"type": "integer", "enum": [0, 30, 60]}
      }
    },
    "plannedRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "cluster_slot",
        "workload",
        "block_index",
        "permutation",
        "planned_ordinal",
        "position",
        "predecessor_arm",
        "arm",
        "preceding_wait"
      ],
      "properties": {
        "run_id": {"type": "string"},
        "cluster_slot": {"type": "integer", "minimum": 1, "maximum": 13},
        "workload": {"enum": ["W1", "W2"]},
        "block_index": {"type": "integer", "minimum": 1, "maximum": 12},
        "permutation": {"enum": ["SDX", "SXD", "DSX", "DXS", "XSD", "XDS"]},
        "planned_ordinal": {"type": "integer", "minimum": 1},
        "position": {"type": "integer", "minimum": 1, "maximum": 3},
        "predecessor_arm": {"enum": ["START", "stock", "mode1", "modeX"]},
        "arm": {"enum": ["stock", "mode1", "modeX"]},
        "preceding_wait": {"$ref": "#/definitions/plannedWait"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"predecessor_arm": {"const": "START"}},
            "required": ["predecessor_arm"]
          },
          "then": {
            "properties": {"position": {"const": 1}},
            "required": ["position"]
          }
        }
      ]
    },
    "plannedExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workloads",
        "schedule_seed",
        "schedule_algorithm",
        "schedule_table",
        "schedule_sha256",
        "pilot_cluster_slots",
        "cluster_slots",
        "runs"
      ],
      "properties": {
        "workloads": {"$ref": "#/definitions/workloads"},
        "schedule_seed": {"$ref": "#/definitions/hex64"},
        "schedule_algorithm": {"const": "t139-a09-v1"},
        "schedule_table": {"$ref": "#/definitions/fileRecord"},
        "schedule_sha256": {"$ref": "#/definitions/hex64"},
        "pilot_cluster_slots": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": [
            {"const": 1},
            {"const": 2},
            {"const": 3},
            {"const": 4},
            {"const": 5},
            {"const": 6},
            {"const": 7},
            {"const": 8}
          ],
          "additionalItems": false
        },
        "cluster_slots": {
          "type": "array",
          "items": {"$ref": "#/definitions/clusterSlot"}
        },
        "runs": {
          "type": "array",
          "minItems": 36,
          "maxItems": 36,
          "items": {"$ref": "#/definitions/plannedRun"}
        }
      }
    },
    "actualWait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "required_s", "monotonic_start_ns", "monotonic_end_ns"],
      "properties": {
        "kind": {"enum": ["none", "arm_gap", "block_gap", "workload_switch"]},
        "required_s": {"type": "integer", "enum": [0, 30, 60]},
        "monotonic_start_ns": {"type": "integer", "minimum": 0},
