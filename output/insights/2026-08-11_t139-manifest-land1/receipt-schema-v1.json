    "liveness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "allocation_id",
        "probe",
        "arm_or_null",
        "workload_or_null",
        "monotonic_ns",
        "raw"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "allocation_id": {"type": "string"},
        "probe": {"enum": ["liveness_run", "allocation_alive", "driver_heartbeat", "filesystem_writable"]},
        "arm_or_null": {
          "type": ["string", "null"],
          "enum": ["stock", "mode1", "modeX", null]
        },
        "workload_or_null": {
          "type": ["string", "null"],
          "enum": ["W1", "W2", null]
        },
        "monotonic_ns": {"type": "integer", "minimum": 0},
        "raw": {"$ref": "#/definitions/fileRecord"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"probe": {"const": "liveness_run"}},
            "required": ["probe"]
          },
          "then": {
            "properties": {
              "arm_or_null": {"enum": ["stock", "mode1", "modeX"]},
              "workload_or_null": {"enum": ["W1", "W2"]}
            },
            "required": ["arm_or_null", "workload_or_null"]
          },
          "else": {
            "properties": {
              "arm_or_null": {"type": "null"},
              "workload_or_null": {"type": "null"}
            },
            "required": ["arm_or_null", "workload_or_null"]
          }
        }
      ]
    },
    "fixedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_sha256", "B_or_null", "seed_or_null"],
      "properties": {
        "input_sha256": {"$ref": "#/definitions/hex64"},
        "B_or_null": {"type": ["integer", "null"]},
        "seed_or_null": {
          "anyOf": [
            {"$ref": "#/definitions/hex64"},
            {"type": "null"}
          ]
        }
      }
    },
    "ledgerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_path", "family_root", "ordinal", "reservation_entry_sha256", "reservation_commit"],
      "properties": {
        "ledger_path": {"$ref": "#/definitions/repoPath"},
        "family_root": {"$ref": "#/definitions/hex40"},
        "ordinal": {"type": "integer", "minimum": 1},
        "reservation_entry_sha256": {"$ref": "#/definitions/hex64"},
        "reservation_commit": {"$ref": "#/definitions/hex40"}
      }
    },
    "admissionTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "kind", "receipt", "fixed_inputs", "ledger_evidence"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["j_derivation", "q_derivation", "stress_check_simulation", "alpha_reservation"]},
        "receipt": {"$ref": "#/definitions/fileRecord"},
        "fixed_inputs": {"$ref": "#/definitions/fixedInputs"},
        "ledger_evidence": {
          "anyOf": [
            {"$ref": "#/definitions/ledgerEvidence"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "stress_check_simulation"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "fixed_inputs": {
                "properties": {
                  "B_or_null": {"type": "integer"},
                  "seed_or_null": {"$ref": "#/definitions/hex64"}
                },
                "required": ["B_or_null", "seed_or_null"]
              }
            },
            "required": ["fixed_inputs"]
          },
          "else": {
            "properties": {
              "fixed_inputs": {
                "properties": {
                  "B_or_null": {"type": "null"},
                  "seed_or_null": {"type": "null"}
                },
                "required": ["B_or_null", "seed_or_null"]
              }
            },
            "required": ["fixed_inputs"]
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "alpha_reservation"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {"ledger_evidence": {"$ref": "#/definitions/ledgerEvidence"}},
            "required": ["ledger_evidence"]
          },
          "else": {
            "properties": {"ledger_evidence": {"type": "null"}},
            "required": ["ledger_evidence"]
          }
        }
      ]
    },
    "qsubResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["returncode", "raw"],
      "properties": {
        "returncode": {"type": "integer"},
        "raw": {"$ref": "#/definitions/fileRecord"}
      }
    },
    "performanceStartedMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256", "created_at_monotonic_ns"],
      "properties": {
        "path": {"$ref": "#/definitions/repoPath"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/definitions/hex64"},
        "created_at_monotonic_ns": {"type": "integer", "minimum": 0}
      }
    },
    "failureEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pointer"],
      "properties": {
        "kind": {"enum": ["a03_environment", "scheduler", "driver", "collector", "correctness"]},
        "pointer": {"$ref": "#/definitions/fileRecord"}
      }
    },
    "environmentObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "scope",
        "run_id_or_null",
        "stat_before_raw",
        "stat_after_raw",
        "stat_before",
        "stat_after",
        "monotonic_start_ns",
        "monotonic_end_ns",
        "load1_diagnostic",
        "malformed_reason"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "scope": {"enum": ["preflight", "pre_run"]},
        "run_id_or_null": {"type": ["string", "null"]},
        "stat_before_raw": {"$ref": "#/definitions/fileRecord"},
        "stat_after_raw": {"$ref": "#/definitions/fileRecord"},
        "stat_before": {
          "type": "array",
          "items": {"type": "integer"}
        },
        "stat_after": {
          "type": "array",
          "items": {"type": "integer"}
        },
        "monotonic_start_ns": {"type": "integer", "minimum": 0},
        "monotonic_end_ns": {"type": "integer", "minimum": 0},
        "load1_diagnostic": {"type": "number"},
        "malformed_reason": {
          "type": ["string", "null"],
          "enum": ["short_columns", "negative_delta", "nonpositive_total", "window_out_of_range", null]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"scope": {"const": "preflight"}},
            "required": ["scope"]
          },
          "then": {
            "properties": {"run_id_or_null": {"type": "null"}},
            "required": ["run_id_or_null"]
          },
          "else": {
            "properties": {"run_id_or_null": {"type": "string"}},
            "required": ["run_id_or_null"]
          }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "cluster_slot_or_null",
        "reason_code",
        "replaces_attempt_id",
        "parent_attempt_id",
        "allocation_id",
        "submitted_at_monotonic_ns",
        "intent_ref",
        "qsub_result",
        "performance_started_marker",
        "environment_observations",
        "failure_evidence"
      ],
      "properties": {
        "attempt_id": {"type": "string"},
        "cluster_slot_or_null": {
          "anyOf": [
            {"type": "integer", "minimum": 1, "maximum": 13},
            {"type": "null"}
          ]
        },
        "reason_code": {"enum": ["pre_performance_infra_failure", "post_performance_failure", "correctness_anomaly", "completed"]},
        "replaces_attempt_id": {"type": ["string", "null"]},
        "parent_attempt_id": {"type": ["string", "null"]},
        "allocation_id": {"type": ["string", "null"]},
        "submitted_at_monotonic_ns": {"type": "integer", "minimum": 0},
        "intent_ref": {"$ref": "#/definitions/fileRecord"},
        "qsub_result": {"$ref": "#/definitions/qsubResult"},
        "performance_started_marker": {
          "anyOf": [
            {"$ref": "#/definitions/performanceStartedMarker"},
            {"type": "null"}
          ]
        },
        "environment_observations": {
          "type": "array",
          "items": {"$ref": "#/definitions/environmentObservation"}
        },
        "failure_evidence": {
          "anyOf": [
            {"$ref": "#/definitions/failureEvidence"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"reason_code": {"const": "completed"}},
            "required": ["reason_code"]
          },
          "then": {
            "properties": {
              "allocation_id": {"type": "string"},
              "performance_started_marker": {"$ref": "#/definitions/performanceStartedMarker"},
              "failure_evidence": {"type": "null"}
            },
            "required": ["allocation_id", "performance_started_marker", "failure_evidence"]
          }
        },
        {
          "if": {
            "properties": {"reason_code": {"const": "pre_performance_infra_failure"}},
            "required": ["reason_code"]
          },
          "then": {
            "properties": {
              "performance_started_marker": {"type": "null"},
              "failure_evidence": {"$ref": "#/definitions/failureEvidence"}
            },
            "required": ["performance_started_marker", "failure_evidence"]
          }
        },
        {
          "if": {
            "properties": {"reason_code": {"const": "post_performance_failure"}},
            "required": ["reason_code"]
          },
          "then": {
            "properties": {"failure_evidence": {"$ref": "#/definitions/failureEvidence"}},
            "required": ["failure_evidence"]
          }
        },
        {
          "if": {
            "properties": {"reason_code": {"const": "correctness_anomaly"}},
            "required": ["reason_code"]
          },
          "then": {
            "properties": {
              "replaces_attempt_id": {"type": "null"},
              "failure_evidence": {
                "allOf": [
                  {"$ref": "#/definitions/failureEvidence"},
                  {
                    "properties": {"kind": {"const": "correctness"}},
                    "required": ["kind"]
                  }
                ]
              }
            },
            "required": ["replaces_attempt_id", "failure_evidence"]
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "declared_use_class",
    "study_stage",
    "series_id",
    "parent_series_id",
    "preregistration",
    "environment",
    "measurement_checkout",
    "dependency_pins",
    "arms",
    "allocations",
    "planned_execution",
    "actual_runs",
    "correctness_evidence",
    "liveness",
    "admission_telemetry",
    "attempts"
  ],
  "properties": {
    "schema_version": {"const": "t139-receipt/v1"},
    "study_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "declared_use_class": {"enum": ["official", "exploration", "qualification", "dry"]},
    "study_stage": {"enum": ["pilot", "main_run"]},
    "series_id": {"$ref": "#/definitions/hex64"},
    "parent_series_id": {
      "anyOf": [
        {"$ref": "#/definitions/hex64"},
        {"type": "null"}
      ]
    },
    "preregistration": {"$ref": "#/definitions/preregistration"},
    "environment": {"$ref": "#/definitions/environment"},
    "measurement_checkout": {"$ref": "#/definitions/measurementCheckout"},
    "dependency_pins": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/definitions/dependencyPin"},
      "allOf": [
        {"contains": {"properties": {"name": {"const": "gflags"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "glog"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "masstree"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "mimalloc"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "googletest"}}, "required": ["name"]}}
      ]
    },
    "arms": {"$ref": "#/definitions/arms"},
    "allocations": {
      "type": "array",
      "items": {"$ref": "#/definitions/allocation"}
    },
    "planned_execution": {"$ref": "#/definitions/plannedExecution"},
    "actual_runs": {
      "type": "array",
      "items": {"$ref": "#/definitions/actualRun"}
    },
    "correctness_evidence": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/definitions/correctnessEvidence"},
      "allOf": [
        {"contains": {"properties": {"arm": {"const": "stock"}, "workload": {"const": "W1"}}, "required": ["arm", "workload"]}},
        {"contains": {"properties": {"arm": {"const": "stock"}, "workload": {"const": "W2"}}, "required": ["arm", "workload"]}},
        {"contains": {"properties": {"arm": {"const": "mode1"}, "workload": {"const": "W1"}}, "required": ["arm", "workload"]}},
        {"contains": {"properties": {"arm": {"const": "mode1"}, "workload": {"const": "W2"}}, "required": ["arm", "workload"]}},
        {"contains": {"properties": {"arm": {"const": "modeX"}, "workload": {"const": "W1"}}, "required": ["arm", "workload"]}},
        {"contains": {"properties": {"arm": {"const": "modeX"}, "workload": {"const": "W2"}}, "required": ["arm", "workload"]}}
      ]
    },
    "liveness": {
      "type": "array",
      "items": {"$ref": "#/definitions/liveness"},
      "allOf": [
        {"contains": {"properties": {"probe": {"const": "liveness_run"}, "arm_or_null": {"const": "stock"}, "workload_or_null": {"const": "W1"}}, "required": ["probe", "arm_or_null", "workload_or_null"]}},
        {"contains": {"properties": {"probe": {"const": "liveness_run"}, "arm_or_null": {"const": "stock"}, "workload_or_null": {"const": "W2"}}, "required": ["probe", "arm_or_null", "workload_or_null"]}},
        {"contains": {"properties": {"probe": {"const": "liveness_run"}, "arm_or_null": {"const": "mode1"}, "workload_or_null": {"const": "W1"}}, "required": ["probe", "arm_or_null", "workload_or_null"]}},
        {"contains": {"properties": {"probe": {"const": "liveness_run"}, "arm_or_null": {"const": "mode1"}, "workload_or_null": {"const": "W2"}}, "required": ["probe", "arm_or_null", "workload_or_null"]}},
        {"contains": {"properties": {"probe": {"const": "liveness_run"}, "arm_or_null": {"const": "modeX"}, "workload_or_null": {"const": "W1"}}, "required": ["probe", "arm_or_null", "workload_or_null"]}},
        {"contains": {"properties": {"probe": {"const": "liveness_run"}, "arm_or_null": {"const": "modeX"}, "workload_or_null": {"const": "W2"}}, "required": ["probe", "arm_or_null", "workload_or_null"]}}
      ]
    },
    "admission_telemetry": {
      "type": "array",
      "items": {"$ref": "#/definitions/admissionTelemetry"}
    },
    "attempts": {
      "type": "array",
      "items": {"$ref": "#/definitions/attempt"}
    }
  }
}
