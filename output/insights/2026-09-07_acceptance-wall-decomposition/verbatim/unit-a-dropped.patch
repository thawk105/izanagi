+def test_publish_uses_same_filesystem_rename_and_unlocks_before_actual_copytree(
+        tmp_path, monkeypatch):
+    session = tmp_path / "pytest-session"
+    request = _shared_request_root(session, "gw-lock", "case")
+    monkeypatch.setenv("PYTEST_XDIST_WORKER", "gw-lock")
+    key = {"fixture": "lock-scope"}
+    cache_root = cache.xdist_session_cache_root(request, "gw-lock")
+    assert cache_root is not None
+    lock_path = cache.cache_lock_path(cache_root, key)
+    real_copytree = cache.shutil.copytree
+    real_rename = cache.os.rename
+    copy_observations = []
+    rename_observations = []
+
+    def observed_copytree(source, destination, *args, **kwargs):
+        with lock_path.open("a+b") as contender:
+            fcntl.flock(contender.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+            fcntl.flock(contender.fileno(), fcntl.LOCK_UN)
+        copy_observations.append((Path(source), Path(destination)))
+        return real_copytree(source, destination, *args, **kwargs)
+
+    def observed_rename(source, destination, *args, **kwargs):
+        source_path = Path(source)
+        destination_path = Path(destination)
+        rename_observations.append((
+            source_path, destination_path,
+            source_path.stat().st_dev, destination_path.parent.stat().st_dev,
+        ))
+        return real_rename(source, destination, *args, **kwargs)
+
+    calls: list[int] = []
+    with mock.patch.object(cache.shutil, "copytree", side_effect=observed_copytree), \
+            mock.patch.object(cache.os, "rename", side_effect=observed_rename):
+        copied, _document = cache.copy_tree_for_pytest(
+            request,
+            destination_name="copy",
+            key_factory=lambda: key,
+            builder=_simple_builder(calls, (_TREE_PAYLOAD,)),
+            process_cache={},
+            ambient_temp_root=session,
+        )
+
+    entry = cache.cache_entry_path(cache_root, key)
+    assert calls == [0]
+    assert copy_observations == [(entry / "tree", copied)]
+    assert len(rename_observations) == 2
+    publish = rename_observations[-1]
+    assert publish[1] == entry
+    assert publish[0].parent == entry.parent
+    assert publish[2] == publish[3]
+    assert (copied / "payload.bin").read_bytes() == _TREE_PAYLOAD
+
