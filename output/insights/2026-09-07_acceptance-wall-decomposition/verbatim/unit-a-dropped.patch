+# -*- coding: utf-8 -*-
+"""T-080 pytest-session host tree cache の隔離と publish 契約を検査する。"""
+from __future__ import annotations
+
+import fcntl
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import textwrap
+import time
+from pathlib import Path
+from unittest import mock
+
+import pytest
+
+from orchestrator.campaign import t080_freeze_migration as migration
+from orchestrator.tests import host_tree_cache as cache
+
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+_KNOWN_BYTES = b'{"known":"literal-sentinel"}\n'
+_HOLDOUT_BYTES = b'{"holdout":"literal-sentinel"}\n'
+_RECEIPT_BYTES = b'{"receipt":"literal-sentinel"}\n'
+_VISIBLE_BYTES = b"git-visible-output-literal-sentinel\n"
+_ORCHESTRATOR_BYTES = b"orchestrator-live-input-literal-sentinel\n"
+_DESCRIPTOR_BYTES = b"descriptor-live-input-literal-sentinel\n"
+_TREE_PAYLOAD = b"host-tree-cache-independent-copy-sentinel\n"
+
+
+def _git(root: Path, *args: str) -> str:
+    return subprocess.run(
+        ["git", *args], cwd=root, check=True,
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+        env=_git_environment(),
+    ).stdout.strip()
+
+
+def _git_environment() -> dict[str, str]:
+    environment = {
+        name: value for name, value in os.environ.items()
+        if not name.startswith("GIT_")
+    }
+    environment.update({
+        "GIT_CONFIG_NOSYSTEM": "1",
+        "GIT_CONFIG_GLOBAL": os.devnull,
+        "GIT_TERMINAL_PROMPT": "0",
+        "GIT_OPTIONAL_LOCKS": "0",
+    })
+    return environment
+
+
+def _git_visible_output_paths(root: Path) -> set[str]:
+    tracked = subprocess.run(
+        ["git", "ls-files", "-z", "-s", "--", "output"],
+        cwd=root, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        env=_git_environment(),
+    ).stdout
+    visible = set()
+    for entry in tracked.split(b"\0"):
+        if not entry:
+            continue
+        metadata, relative = entry.decode("utf-8").split("\t", 1)
+        if metadata.split(" ", 1)[0] in {"100644", "100755"}:
+            visible.add(relative)
+    untracked = subprocess.run(
+        [
+            "git", "ls-files", "-z", "--others", "--exclude-standard",
+            "--", "output",
+        ],
+        cwd=root, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        env=_git_environment(),
+    ).stdout
+    for relative_raw in untracked.split(b"\0"):
+        if not relative_raw:
+            continue
+        relative = relative_raw.decode("utf-8")
+        path = root / relative
+        if path.is_file() and not path.is_symlink():
+            visible.add(relative)
+    return visible
+
+
+def _live_key(root: Path, **kwargs):
+    return cache.t080_live_repository_key(
+        root,
+        ccbench_relative=migration.CCBENCH_REL,
+        known_axes_relative=migration.KNOWN_AXES_REL,
+        holdout_relative=migration.HOLDOUT_REL,
+        receipt_relative=migration.RECEIPT_REL,
+        visible_output_paths=_git_visible_output_paths,
+        copied_file_relatives=("docs/descriptor.md",),
+        **kwargs,
+    )
+
+
+def _configure_repo(root: Path) -> None:
+    _git(root, "config", "user.name", "Host Tree Cache Test")
+    _git(root, "config", "user.email", "host-tree-cache@example.invalid")
+    _git(root, "config", "commit.gpgsign", "false")
+
+
+def _make_key_repo(tmp_path: Path) -> Path:
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    origin = tmp_path / "ccbench-origin"
+    origin.mkdir()
+    _git(origin, "init", "-q")
+    _configure_repo(origin)
+    (origin / "source.txt").write_bytes(b"ccbench-head-zero\n")
+    _git(origin, "add", "source.txt")
+    _git(origin, "commit", "-q", "-m", "ccbench basis")
+
+    root = tmp_path / "live-repository"
+    root.mkdir()
+    _git(root, "init", "-q")
+    _configure_repo(root)
+    (root / "orchestrator").mkdir()
+    (root / "orchestrator" / "cache_input.py").write_bytes(_ORCHESTRATOR_BYTES)
+    (root / "docs").mkdir()
+    (root / "docs" / "descriptor.md").write_bytes(_DESCRIPTOR_BYTES)
+    payloads = {
+        migration.KNOWN_AXES_REL: _KNOWN_BYTES,
+        migration.HOLDOUT_REL: _HOLDOUT_BYTES,
+        migration.RECEIPT_REL: _RECEIPT_BYTES,
+        "output/visible.bin": _VISIBLE_BYTES,
+    }
+    for relative, raw in payloads.items():
+        target = root / relative
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(raw)
+    _git(
+        root, "-c", "protocol.file.allow=always", "submodule", "add", "-q",
+        str(origin), migration.CCBENCH_REL,
+    )
+    _git(root, "add", "-A")
+    _git(root, "commit", "-q", "-m", "live repository basis")
+    assert _git(root, "status", "--porcelain=v1", "--untracked-files=all") == ""
+    return root
+
+
+def _simple_builder(counter: list[int], payloads: tuple[bytes, ...]):
+    def build(parent: Path):
+        index = len(counter)
+        counter.append(index)
+        root = parent / "base"
+        root.mkdir()
+        (root / "payload.bin").write_bytes(payloads[index])
+        return root, root / "receipt.json", {"nested": {"value": index}}
+
+    return build
+
+
+def _shared_request_root(session: Path, worker: str, name: str) -> Path:
+    root = session / f"popen-{worker}" / name
+    root.mkdir(parents=True)
+    return root
+
+
+def _build_git_base(parent: Path):
+    origin = parent / "submodule-origin"
+    origin.mkdir()
+    _git(origin, "init", "-q")
+    _configure_repo(origin)
+    (origin / "source.txt").write_bytes(b"submodule-base-sentinel\n")
+    _git(origin, "add", "source.txt")
+    _git(origin, "commit", "-q", "-m", "submodule basis")
+
+    root = parent / "t080-stub-free-e2e"
+    root.mkdir()
+    _git(root, "init", "-q")
+    _configure_repo(root)
+    (root / "payload.bin").write_bytes(_TREE_PAYLOAD)
+    (root / "payload-link").symlink_to("payload.bin")
+    receipt = root / migration.RECEIPT_REL
+    receipt.parent.mkdir(parents=True)
+    receipt.write_bytes(b"cached-receipt-literal-sentinel\n")
+    _git(
+        root, "-c", "protocol.file.allow=always", "submodule", "add", "-q",
+        str(origin), migration.CCBENCH_REL,
+    )
+    _git(root, "add", "-A")
+    _git(root, "commit", "-q", "-m", "cached tree basis")
+    return root, receipt, {"nested": {"value": "document-sentinel"}}
+
