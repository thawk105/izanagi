+def test_live_input_change_during_builder_is_not_published_and_is_rebuilt_fresh(
+        tmp_path, monkeypatch):
+    session = tmp_path / "pytest-session"
+    request = _shared_request_root(session, "gw-drift", "case")
+    monkeypatch.setenv("PYTEST_XDIST_WORKER", "gw-drift")
+    state = {"generation": 0}
+    calls: list[int] = []
+
+    def key_factory():
+        return {"generation": state["generation"]}
+
+    def builder(parent: Path):
+        index = len(calls)
+        calls.append(index)
+        root = parent / "base"
+        root.mkdir()
+        (root / "payload.bin").write_bytes(
+            b"unstable-build\n" if index == 0 else b"stable-rebuild\n"
+        )
+        if index == 0:
+            state["generation"] = 1
+        return root, root / "receipt.json", {"generation": index}
+
+    copied, document = cache.copy_tree_for_pytest(
+        request,
+        destination_name="copy",
+        key_factory=key_factory,
+        builder=builder,
+        process_cache={},
+        ambient_temp_root=session,
+    )
+
+    assert calls == [0, 1]
+    assert (copied / "payload.bin").read_bytes() == b"stable-rebuild\n"
+    assert document == {"generation": 1}
+    cache_root = cache.xdist_session_cache_root(request, "gw-drift")
+    assert cache_root is not None
+    assert not cache.cache_entry_path(cache_root, {"generation": 0}).exists()
+
