index 000000000..65fc06f66
--- /dev/null
+++ b/orchestrator/tests/host_tree_cache.py
@@ -0,0 +1,465 @@
+# -*- coding: utf-8 -*-
+"""pytest session 内だけで共有する test tree cache。
+
+同一 uid の test が予測可能な cache path を直接改変することは隔離しない。
+process 隔離や権限制御を提供する機構ではない。
+"""
+from __future__ import annotations
+
+import atexit
+import fcntl
+import hashlib
+import json
+import os
+import shutil
+import stat
+import subprocess
+import tempfile
+from pathlib import Path
+from typing import Callable, MutableMapping
+
+
+_SCHEMA = "izanagi-pytest-host-tree-cache/v1"
+_READY_BYTES = b"izanagi-pytest-host-tree-cache-ready-v1\n"
+_CACHE_DIRECTORY = ".izanagi-host-tree-cache-v1"
+
+
+class HostTreeCacheError(RuntimeError):
+    """host tree cache を安全に利用できない。"""
+
+
+class _InputChanged(HostTreeCacheError):
+    """builder 実行中に cache key の live input が変化した。"""
+
+
+def _git_environment() -> dict[str, str]:
+    environment = {
+        name: value for name, value in os.environ.items()
+        if not name.startswith("GIT_")
+    }
+    environment.update({
+        "GIT_CONFIG_NOSYSTEM": "1",
+        "GIT_CONFIG_GLOBAL": os.devnull,
+        "GIT_TERMINAL_PROMPT": "0",
+        "GIT_OPTIONAL_LOCKS": "0",
+    })
+    return environment
+
+
+def _git_bytes(root: Path, *args: str) -> bytes:
+    return subprocess.run(
+        ["git", *args], cwd=root, check=True,
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        env=_git_environment(),
+    ).stdout
+
+
+def _git_text(root: Path, *args: str) -> str:
+    return _git_bytes(root, *args).decode("utf-8").strip()
+
+
+def _stable_regular_bytes(path: Path) -> bytes:
+    before = path.lstat()
+    if not stat.S_ISREG(before.st_mode) or path.is_symlink():
+        raise HostTreeCacheError(f"cache key input が regular file でない: {path}")
+    raw = path.read_bytes()
+    after = path.lstat()
+    before_identity = (
+        before.st_dev, before.st_ino, before.st_mode, before.st_size,
+        before.st_mtime_ns, before.st_ctime_ns,
+    )
+    after_identity = (
+        after.st_dev, after.st_ino, after.st_mode, after.st_size,
+        after.st_mtime_ns, after.st_ctime_ns,
+    )
+    if before_identity != after_identity or len(raw) != after.st_size:
+        raise HostTreeCacheError(f"cache key input が読取中に変化した: {path}")
+    return raw
+
+
+def _relative_input_path(relative: str) -> Path:
+    if type(relative) is not str or not relative:
+        raise HostTreeCacheError(f"cache key input path が相対 path でない: {relative!r}")
+    path = Path(relative)
+    if path.is_absolute() or ".." in path.parts:
+        raise HostTreeCacheError(
+            f"cache key input path が相対 path でない: {relative!r}"
+        )
+    return path
+
+
+def _copied_live_inputs_sha256(
+    source_root: Path,
+    *,
+    tree_relatives: tuple[str, ...],
+    file_relatives: tuple[str, ...],
+) -> str:
+    """HEAD と porcelain status の dirty bytes で live copy input を束縛する。"""
+    trees = tuple(_relative_input_path(relative) for relative in tree_relatives)
+    files = tuple(_relative_input_path(relative) for relative in file_relatives)
+    pathspecs = tuple(dict.fromkeys(
+        path.as_posix() for path in (*trees, *files)
+    ))
+    if not pathspecs:
+        raise HostTreeCacheError("cache key の live copy input が空")
+
+    status_raw = _git_bytes(
+        source_root, "status", "--porcelain=v1", "-z",
+        "--untracked-files=all", "--", *pathspecs,
+    )
+    status_records = []
+    for raw_entry in status_raw.split(b"\0"):
+        if not raw_entry:
+            continue
+        if len(raw_entry) < 4 or raw_entry[2:3] != b" ":
+            raise HostTreeCacheError("git status porcelain entry が不正")
+        status = raw_entry[:2].decode("ascii")
+        if "R" in status or "C" in status:
+            # porcelain v1 -z の rename/copy は二 path record になる。曖昧に
+            # 解釈して cache hit させず、fresh builder へ倒す。
+            raise HostTreeCacheError("rename/copy の live copy input を束縛できない")
+        relative = _relative_input_path(raw_entry[3:].decode("utf-8"))
+        path = source_root / relative
+        record = {"path": relative.as_posix(), "status": status}
+        if path.exists() or path.is_symlink():
+            raw = _stable_regular_bytes(path)
+            record.update({
+                "mode": stat.S_IMODE(path.lstat().st_mode),
+                "sha256": hashlib.sha256(raw).hexdigest(),
+            })
+        status_records.append(record)
+
+    # copytree は ignored file も複製する。pycache/pyc 以外が tree 内にあれば
+    # HEAD と porcelain status で束縛できないため cache 自体を使わない。
+    ignored_pathspecs = (*trees, *files)
+    if ignored_pathspecs:
+        ignored_raw = _git_bytes(
+            source_root, "ls-files", "-z", "--others", "--ignored",
+            "--exclude-standard", "--",
+            *(path.as_posix() for path in ignored_pathspecs),
+        )
+        for raw_relative in ignored_raw.split(b"\0"):
+            if not raw_relative:
+                continue
+            relative = _relative_input_path(raw_relative.decode("utf-8"))
+            if (
+                "__pycache__" not in relative.parts
+                and not relative.name.endswith(".pyc")
+            ):
+                raise HostTreeCacheError(
+                    f"cache key に束縛できない ignored copy input: {relative}"
+                )
+
+    encoded = json.dumps(
+        {"status": sorted(status_records, key=lambda record: record["path"])},
+        ensure_ascii=False, sort_keys=True, separators=(",", ":"),
+    ).encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def t080_live_repository_key(
+    source_root: Path,
+    *,
+    ccbench_relative: str,
+    known_axes_relative: str,
+    holdout_relative: str,
+    receipt_relative: str,
+    visible_output_paths: Callable[[Path], set[str]],
+    copied_tree_relatives: tuple[str, ...] = ("orchestrator",),
+    copied_file_relatives: tuple[str, ...] = (),
+    r_trailer: str = "AI-Agent: none",
+    extra_r_path: bool = False,
+    issue_receipt: bool = True,
+    distinct_basis_blob: bool = False,
+) -> dict[str, object] | None:
+    """T-080 base が読む live repository state を fail-closed に束縛する。"""
+    source_root = Path(source_root)
+    try:
+        repository_head = _git_text(source_root, "rev-parse", "HEAD")
+        ccbench_head = _git_text(
+            source_root / ccbench_relative, "rev-parse", "HEAD",
+        )
+        for name, oid in (
+            ("repository HEAD", repository_head),
+            ("ccbench HEAD", ccbench_head),
+        ):
+            if len(oid) != 40 or any(char not in "0123456789abcdef" for char in oid):
+                raise HostTreeCacheError(f"{name} が SHA-1 object id でない")
+        known_raw = _stable_regular_bytes(source_root / known_axes_relative)
+        holdout_raw = _stable_regular_bytes(source_root / holdout_relative)
+        receipt_raw = _stable_regular_bytes(source_root / receipt_relative)
+        visible = visible_output_paths(source_root)
+        if type(visible) is not set or not all(type(path) is str for path in visible):
+            raise HostTreeCacheError("Git-visible output path 集合が不正")
+        copied_live_inputs_sha256 = _copied_live_inputs_sha256(
+            source_root,
+            tree_relatives=copied_tree_relatives,
+            file_relatives=copied_file_relatives,
+        )
+        visible_paths_raw = json.dumps(
+            sorted(visible), ensure_ascii=False, separators=(",", ":"),
+        ).encode("utf-8")
+        return {
+            "schema_version": "izanagi-t080-host-cache-key/v1",
+            "r_trailer": r_trailer,
+            "extra_r_path": extra_r_path,
+            "issue_receipt": issue_receipt,
+            "distinct_basis_blob": distinct_basis_blob,
+            "repository_head": repository_head,
+            "ccbench_head": ccbench_head,
+            "known_axes_blob_sha256": hashlib.sha256(known_raw).hexdigest(),
+            "holdout_blob_sha256": hashlib.sha256(holdout_raw).hexdigest(),
+            "issued_receipt_blob_sha256": hashlib.sha256(receipt_raw).hexdigest(),
+            "git_visible_output_paths_sha256": hashlib.sha256(
+                visible_paths_raw,
+            ).hexdigest(),
+            "copied_live_inputs_sha256": copied_live_inputs_sha256,
+        }
+    except (
+        HostTreeCacheError, AssertionError, OSError, subprocess.SubprocessError,
+        UnicodeError,
+    ):
+        return None
+
+
+def cache_key_digest(key: object) -> str:
+    """JSON key を canonical bytes にして cache path 用 digest を返す。"""
+    try:
+        raw = json.dumps(
+            {"schema": _SCHEMA, "key": key},
+            ensure_ascii=False,
+            sort_keys=True,
+            separators=(",", ":"),
+            allow_nan=False,
+        ).encode("utf-8")
+    except (TypeError, ValueError) as exc:
+        raise HostTreeCacheError("host tree cache key が canonical JSON でない") from exc
+    return hashlib.sha256(raw).hexdigest()
+
+
+def xdist_session_cache_root(temp_root: Path, worker: str) -> Path | None:
+    """popen-<worker> の親から session-local な共有 cache root を導出する。"""
+    resolved = Path(temp_root).resolve()
+    expected = f"popen-{worker}"
+    for candidate in (resolved, *resolved.parents):
+        if candidate.name == expected:
+            return candidate.parent / _CACHE_DIRECTORY
+    return None
+
+
+def cache_entry_path(cache_root: Path, key: object) -> Path:
+    """専用 test が atomic publish の実体を観測するための deterministic path。"""
+    return Path(cache_root) / "entries" / cache_key_digest(key)
+
+
+def cache_lock_path(cache_root: Path, key: object) -> Path:
+    """専用 test が実 flock namespace を観測するための deterministic path。"""
+    return Path(cache_root) / "locks" / f"{cache_key_digest(key)}.lock"
+
+
+def _load_published(entry: Path) -> tuple[Path, dict] | None:
+    if not entry.exists():
+        return None
+    tree = entry / "tree"
+    document_path = entry / "document.json"
+    ready = entry / "READY"
+    if (
+        not entry.is_dir()
+        or entry.is_symlink()
+        or not tree.is_dir()
+        or tree.is_symlink()
+        or not document_path.is_file()
+        or document_path.is_symlink()
+        or not ready.is_file()
+        or ready.is_symlink()
+    ):
+        raise HostTreeCacheError("published host tree cache entry が不完全")
+    if ready.read_bytes() != _READY_BYTES:
+        raise HostTreeCacheError("published host tree cache READY marker が不正")
+    try:
+        document = json.loads(document_path.read_bytes())
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise HostTreeCacheError("published host tree cache document が不正") from exc
+    if type(document) is not dict:
+        raise HostTreeCacheError("published host tree cache document が object でない")
+    return tree, document
+
+
+def _copy_result(
+    source: Path, destination: Path, document: dict,
+) -> tuple[Path, dict]:
+    # test へ返す tree は常に独立した実体であり、lock の外で複製する。
+    shutil.copytree(source, destination, symlinks=True)
+    return destination, document
+
+
+def _build_in_parent(
+    parent: Path,
+    builder: Callable[[Path], tuple[Path, Path, dict]],
+) -> tuple[Path, dict]:
+    built_root, _receipt, document = builder(parent)
+    built_root = Path(built_root)
+    try:
+        contained = built_root.resolve().is_relative_to(parent.resolve())
+    except OSError as exc:
+        raise HostTreeCacheError("builder result path を解決できない") from exc
+    if not contained or not built_root.is_dir() or built_root.is_symlink():
+        raise HostTreeCacheError("builder result が staging parent 内の directory でない")
+    if type(document) is not dict:
+        raise HostTreeCacheError("builder document が object でない")
+    return built_root, document
+
+
+def _fresh_copy(
+    *,
+    temp_root: Path,
+    destination: Path,
+    builder: Callable[[Path], tuple[Path, Path, dict]],
+) -> tuple[Path, dict]:
+    parent = Path(tempfile.mkdtemp(prefix="izanagi-host-tree-fresh-", dir=temp_root))
+    try:
+        built_root, document = _build_in_parent(parent, builder)
+        return _copy_result(built_root, destination, document)
+    finally:
+        shutil.rmtree(parent, ignore_errors=True)
+
+
+def _process_cached_copy(
+    *,
+    key: object,
+    key_factory: Callable[[], object | None],
+    process_cache: MutableMapping[str, tuple[Path, dict]],
+    temp_root: Path,
+    destination: Path,
+    builder: Callable[[Path], tuple[Path, Path, dict]],
+) -> tuple[Path, dict]:
+    digest = cache_key_digest(key)
+    cached = process_cache.get(digest)
+    if cached is None:
+        parent = Path(tempfile.mkdtemp(
+            prefix="izanagi-host-tree-process-", dir=temp_root,
+        ))
+        try:
+            cached = _build_in_parent(parent, builder)
+            if key_factory() != key:
+                raise _InputChanged(
+                    "process tree cache build 中に live input が変化した"
+                )
+        except BaseException:
+            shutil.rmtree(parent, ignore_errors=True)
+            raise
+        atexit.register(shutil.rmtree, parent, ignore_errors=True)
+        process_cache[digest] = cached
+    source, document = cached
+    return _copy_result(source, destination, document)
+
+
+def _shared_cached_copy(
+    *,
+    cache_root: Path,
+    key: object,
+    key_factory: Callable[[], object | None],
+    destination: Path,
+    builder: Callable[[Path], tuple[Path, Path, dict]],
+) -> tuple[Path, dict]:
+    entry = cache_entry_path(cache_root, key)
+    loaded = _load_published(entry)
+    if loaded is not None:
+        if key_factory() != key:
+            raise _InputChanged("host tree cache hit 前に live input が変化した")
+        return _copy_result(loaded[0], destination, loaded[1])
+
+    entries = cache_root / "entries"
+    locks = cache_root / "locks"
+    entries.mkdir(parents=True, exist_ok=True)
+    locks.mkdir(parents=True, exist_ok=True)
+    lock_path = cache_lock_path(cache_root, key)
+    with lock_path.open("a+b") as lock:
+        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
+        try:
+            loaded = _load_published(entry)
+            if loaded is None:
+                staging = Path(tempfile.mkdtemp(
+                    prefix=f".{entry.name}.staging-", dir=entries,
+                ))
+                try:
+                    build_parent = staging / "build"
+                    build_parent.mkdir()
+                    built_root, document = _build_in_parent(build_parent, builder)
+                    if key_factory() != key:
+                        raise _InputChanged(
+                            "host tree cache build 中に live input が変化した"
+                        )
+                    os.rename(built_root, staging / "tree")
+                    shutil.rmtree(build_parent)
+                    (staging / "document.json").write_text(
+                        json.dumps(
+                            document, ensure_ascii=False, sort_keys=True,
+                            separators=(",", ":"), allow_nan=False,
+                        ),
+                        encoding="utf-8",
+                    )
+                    (staging / "READY").write_bytes(_READY_BYTES)
+                    os.rename(staging, entry)
+                except BaseException:
+                    shutil.rmtree(staging, ignore_errors=True)
+                    raise
+                loaded = _load_published(entry)
+                assert loaded is not None
+        finally:
+            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
+    if key_factory() != key:
+        raise _InputChanged("host tree cache copy 前に live input が変化した")
+    # 48 worker 分の返却 copytree を直列化しない。
+    return _copy_result(loaded[0], destination, loaded[1])
+
+
+def copy_tree_for_pytest(
+    temp_root: Path,
+    *,
+    destination_name: str,
+    destination_root: Path | None = None,
+    key_factory: Callable[[], object | None],
+    builder: Callable[[Path], tuple[Path, Path, dict]],
+    process_cache: MutableMapping[str, tuple[Path, dict]],
+    ambient_temp_root: Path,
+) -> tuple[Path, dict]:
+    """xdist は session cache、serial は process cache から独立 tree を返す。"""
+    temp_root = Path(temp_root)
+    destination = Path(destination_root or temp_root) / destination_name
+    ambient_temp_root = Path(ambient_temp_root)
+    key = key_factory()
+    worker = os.environ.get("PYTEST_XDIST_WORKER")
+
+    if key is None:
+        return _fresh_copy(
+            temp_root=ambient_temp_root, destination=destination, builder=builder,
+        )
+    if not worker:
+        try:
+            return _process_cached_copy(
+                key=key, key_factory=key_factory, process_cache=process_cache,
+                temp_root=ambient_temp_root, destination=destination,
+                builder=builder,
+            )
+        except _InputChanged:
+            return _fresh_copy(
+                temp_root=ambient_temp_root, destination=destination,
+                builder=builder,
+            )
+
+    cache_root = xdist_session_cache_root(temp_root, worker)
+    if cache_root is None:
+        return _fresh_copy(
+            temp_root=ambient_temp_root, destination=destination, builder=builder,
+        )
+    try:
+        return _shared_cached_copy(
+            cache_root=cache_root, key=key, key_factory=key_factory,
+            destination=destination, builder=builder,
+        )
+    except _InputChanged:
+        # 不安定な live input に cache product を束縛しない。旧経路相当を必ず再構築する。
+        return _fresh_copy(
+            temp_root=ambient_temp_root, destination=destination, builder=builder,
+        )
