+            )
+            (root / "payload-link").symlink_to("payload.bin")
+            return root, root / "receipt.json", {"basis": "shared"}
+
+        def final_builder(parent):
+            (session / "final-builder-calls" / str(os.getpid())).write_bytes(
+                b"final-built\\n"
+            )
+            root, _basis_document = cache.copy_tree_for_pytest(
+                request, destination_name="base", destination_root=parent,
+                key_factory=lambda: basis_key, builder=basis_builder,
+                process_cache={}, ambient_temp_root=session,
+            )
+            return root, root / "receipt.json", {"nested": {"value": "shared"}}
+
+        copied, document = cache.copy_tree_for_pytest(
+            request, destination_name="copy", key_factory=lambda: final_key,
+            builder=final_builder, process_cache={}, ambient_temp_root=session,
+        )
+        payload = copied / "payload.bin"
+        print(json.dumps({
+            "root": str(copied),
+            "inode": [payload.stat().st_dev, payload.stat().st_ino],
+            "bytes": payload.read_text(encoding="utf-8"),
+            "symlink": (copied / "payload-link").is_symlink(),
+            "document": document,
+        }, sort_keys=True))
+        """
+    )
+    processes = [
+        subprocess.Popen(
+            [sys.executable, "-c", script, str(session), f"gw{index}"],
+            cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            text=True, env={**os.environ, "PYTHONPATH": str(ROOT)},
+        )
+        for index in range(7)
+    ]
+    try:
+        deadline = time.monotonic() + 15.0
+        while len(list(session.glob("ready-gw*"))) != 7:
+            assert time.monotonic() < deadline, "concurrent cache workers did not become ready"
+            time.sleep(0.01)
+        go.write_bytes(b"go\n")
+        results = []
+        for process in processes:
+            stdout, stderr = process.communicate(timeout=20)
+            assert process.returncode == 0, stderr
+            results.append(json.loads(stdout))
+    finally:
+        for process in processes:
+            if process.poll() is None:
+                process.kill()
+            process.wait()
+
+    assert len(list(basis_counter.iterdir())) == 1
+    assert len(list(final_counter.iterdir())) == 1
+    assert len({result["root"] for result in results}) == 7
+    assert len({tuple(result["inode"]) for result in results}) == 7
+    assert {result["bytes"] for result in results} == {
