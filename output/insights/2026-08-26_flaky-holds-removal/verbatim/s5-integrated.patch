+def git_ignored_output_ancestor_directories(
+        repo_root: Path,
+) -> GitIgnoredOutputAncestorDirectories:
+    """規則由来 ignored prefix の祖先 directory 集合を返す。
+
+    ``exact`` は literal prefix の厳密な祖先だけを含み、root ``.`` は常に含む。
+    ``subtree_roots`` は wildcard より前の静的 directory であり、その directory と
+    配下の全 directory を祖先扱いする。どちらも規則 bytes から導き、tree の実在を
+    観測しない。
+    """
+    literal_candidates, raw_wildcard_roots = _rule_candidates(repo_root)
+    matched_literals = _check_rule_candidates(repo_root, literal_candidates)
+    exact = {"."}
+    for raw_candidate in matched_literals:
+        if raw_candidate == b"output":
+            continue
+        prefix = os.fsdecode(raw_candidate.removeprefix(b"output/"))
+        components = prefix.split("/")
+        exact.update(
+            "/".join(components[:end])
+            for end in range(1, len(components))
+        )
+    return GitIgnoredOutputAncestorDirectories(
+        exact=frozenset(exact),
+        subtree_roots=frozenset(
+            os.fsdecode(root) for root in raw_wildcard_roots
+        ),
+    )
